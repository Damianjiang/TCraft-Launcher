* text=auto

# 保持脚本和源码为 LF，避免 Windows 检出后弄坏 linux.sh / shebang
*.sh text eol=lf
*.py text eol=lf
*.java text eol=lf
*.c text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.svg text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 二进制文件不参与换行转换
*.exe binary
*.jar binary
*.zip binary
*.png binary
*.jpg binary
*.ico binary
*.ttf binary
