<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<OutputType>Library</OutputType>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<OutDir>bin\</OutDir>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<Configurations>Debug;Release;Snapshot</Configurations>
		<Deterministic>true</Deterministic>
		<LangVersion>13.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
    <Resource Include="UI\Assets\IconPacks\**\*.svg" />
    <EmbeddedResource Include="UI\Assets\IconPacks\**\*.svg">
      <LogicalName>IconPacks/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="PolySharp" Version="1.15.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<!-- WinHttpHandler：dll 随本包输出到 bin，经 regen_gz 压缩后由主程序内嵌（单文件加载）。
			 TCl 主工程在 Windows 10 1607+ 用它启用 HTTP/2 多路复用（下载提速），Win7 回退 HttpClientHandler。 -->
		<PackageReference Include="System.Net.Http.WinHttpHandler" Version="7.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="System.Diagnostics.CodeAnalysis" />
		<Using Include="System.IO" />
		<Using Include="System.Collections" />
		<Using Include="System.Collections.Generic" />
		<Using Include="System.Collections.Concurrent" />
		<Using Include="System.Text" />
		<Using Include="System.Text.RegularExpressions" />
		<Using Include="System.Net" />
		<Using Include="System.Runtime.CompilerServices" />
		<Using Include="System.Runtime.InteropServices" />
		<Using Include="Newtonsoft.Json" />
		<Using Include="Newtonsoft.Json.Linq" />
		<Using Include="TClKit" />
		<Using Include="TClKit.IO" />
		<Using Include="TClKit.Text" />
		<Using Include="TClKit.Value" />
		<Using Include="TClKit.Collections" />
		<Using Include="TClKit.Concurrency" />
		<Using Include="TClKit.Progress" />
		<Using Include="TClKit.Config" />
		<Using Include="TClKit.Logging" />
		<Using Include="TClKit.Patch" />
		<Using Include="TClKit.Security" />
		<Using Include="TClKit.Platform" />
		<Using Include="TClKit.Ext" />
		<Using Include="TClKit.Wpf" />
		<Using Include="TClKit.Wpf.Extensions" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\TClKit\Shared\TClKit.csproj" />
	  <ProjectReference Include="..\TClKit\Wpf\TClKit.Wpf.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>$(DefineConstants);SNAPSHOT</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'" />

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Snapshot|AnyCPU'">
		<Optimize>True</Optimize>
	</PropertyGroup>

	<!-- 内嵌的资源 -->
	<ItemGroup>
		<EmbeddedResource Include="Launch\JavaWrapper.jar" LogicalName="Launch\JavaWrapper.jar" />
		<EmbeddedResource Include="Launch\LwjglUnsafeAgent.jar" LogicalName="Launch\LwjglUnsafeAgent.jar" />
		<EmbeddedResource Include="Resource\ModNameIndex.dat" LogicalName="Resource\ModNameIndex.dat" />
		<EmbeddedResource Include="Minecraft\OptiFineHashes.json" LogicalName="Minecraft\OptiFineHashes.json" />
	</ItemGroup>
	<ItemGroup>
	  <Reference Include="Microsoft.VisualBasic" />
	  <Reference Include="Newtonsoft.Json">
	    <HintPath>..\TCl\Resources\Newtonsoft.Json.dll</HintPath>
	  </Reference>
	</ItemGroup>

</Project>
