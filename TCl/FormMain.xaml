<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCraft"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
    x:Name="WindMain" x:Class="FormMain" Style="{StaticResource MyWindow}"
    AllowDrop="True" Topmost="True" Title="TCraft Launcher" AllowsTransparency="True" MinHeight="470" MinWidth="810" 
    ScrollViewer.VerticalScrollBarVisibility="Disabled" Icon="/TCraft Launcher;component/Images/Heads/Logo.png" WindowStyle="None" 
    ResizeMode="CanMinimize" Background="{x:Null}" d:DesignWidth="870" d:DesignHeight="520" Width="850" Height="500" 
    RenderTransformOrigin="0.5,0.5">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ThumbnailClipMargin="{Binding Margin, ElementName=PanForm}" />
    </Window.TaskbarItemInfo>
    <Grid x:Name="PanBack" SnapsToDevicePixels="True" UseLayoutRounding="True" Margin="10" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TransformGroup>
                <RotateTransform x:Name="TransformRotate" Angle="-4" />
                <TranslateTransform x:Name="TransformPos" X="0" Y="60" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Rectangle x:Name="ResizerT" Stroke="{x:Null}" StrokeThickness="0.0001" Height="8" VerticalAlignment="Top" Margin="13,0" Cursor="SizeNS">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#21000000" Offset="1" />
                    <GradientStop Color="#11000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerB" Stroke="{x:Null}" StrokeThickness="0.0001" Height="8" VerticalAlignment="Bottom" Margin="13,0" Cursor="SizeNS">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#21000000" Offset="0" />
                    <GradientStop Color="#11000000" Offset="0.3" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerR" HorizontalAlignment="Right" Margin="0,13" Stroke="{x:Null}" StrokeThickness="0.0001" Width="8" Cursor="SizeWE">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="#21000000" Offset="0" />
                    <GradientStop Color="#11000000" Offset="0.3" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerL" HorizontalAlignment="Left" Stroke="{x:Null}" Width="8" Margin="0,13" StrokeThickness="0.0001" Cursor="SizeWE">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="1,0.5" StartPoint="0,0.5">
                    <GradientStop Color="#21000000" Offset="1" />
                    <GradientStop Color="#11000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="0" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerLT" HorizontalAlignment="Left" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Top" Height="13" Cursor="SizeNWSE">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,1" GradientOrigin="1,1" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerLB" HorizontalAlignment="Left" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Bottom" Height="13" Cursor="SizeNESW">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerRB" HorizontalAlignment="Right" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Bottom" Height="13" Cursor="SizeNWSE">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ResizerRT" HorizontalAlignment="Right" Stroke="{x:Null}" Width="13" StrokeThickness="0.0001" VerticalAlignment="Top" Height="13" Cursor="SizeNESW">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX="1" RadiusY="1">
                    <GradientStop Color="#21000000" Offset="0.2" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Border Margin="8" x:Name="BorderForm">
            <Border.Clip>
                <RectangleGeometry x:Name="RectForm" RadiusX="6" RadiusY="6" />
            </Border.Clip>
            <Grid x:Name="PanForm" SnapsToDevicePixels="False" UseLayoutRounding="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Canvas x:Name="ImgBack" IsHitTestVisible="False" Grid.Row="1" RenderOptions.BitmapScalingMode="LowQuality"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                <!-- 背景视频层：位于背景图之上、内容之下；不拦截鼠标；默认 Collapsed。
                     起不在 XAML 构造（首个 MediaElement 会初始化 WPF 媒体栈），
                     改由代码属性 VidBack 惰性创建，仅当用户真的使用背景视频时才实例化。 -->
                <Grid x:Name="PanTitle" Height="48">
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                            <GradientStop Color="{StaticResource ColorObject4}" Offset="0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <local:MyImage x:Name="ImgTitle" IsHitTestVisible="False" Stretch="UniformToFill" IsEnabled="False" RenderOptions.BitmapScalingMode="LowQuality" />
                    <local:MyIconButton x:Name="BtnTitleClose" HorizontalAlignment="Right" Height="28" VerticalAlignment="Center" Width="28" Margin="0,0,12,0" Theme="White" 
                                       LogoScale="0.72" Logo="F1 M2,0 L0,2 8,10 0,18 2,20 10,12 18,20 20,18 12,10 20,2 18,0 10,8 2,0Z" />
                    <local:MyIconButton x:Name="BtnTitleMin" HorizontalAlignment="Right" Height="28" VerticalAlignment="Center" Width="28" Margin="0,0,44,0" Theme="White" 
                                       LogoScale="0.72" Logo="F1 M0,0 h15 v2 h-15 v-2 Z" />
                    <local:MyIconButton x:Name="BtnTitleLang" HorizontalAlignment="Right" Height="28" VerticalAlignment="Center" Width="28" Margin="0,0,84,0" Theme="White"
                                       ToolTip="切换界面语言" LogoScale="0.9" />
                    <!-- （G1 全局搜索）：标题栏放大镜，Ctrl+K 同效 -->
                    <local:MyIconButton x:Name="BtnTitleSearch" HorizontalAlignment="Right" Height="28" VerticalAlignment="Center" Width="28" Margin="0,0,124,0" Theme="White"
                                       ToolTip="全局搜索（Ctrl+K）" SvgIcon="lucide/search" LogoScale="0.9" />
                    <!-- （改真自适应）：外层 Stretch + 右 margin 让出右侧「搜索/语言/最小化/关闭」图标区，
                         两个 1* 平衡列只在「徽章右缘 → 图标区左缘」间分配，按钮组严格居中且不压图标；
                         随窗口变窄则由代码 AdaptTitleTabsToWidth 实测并自动缩字号/间距（FormMain_SizeChanged 重算）。 -->
                    <Grid x:Name="PanTitleMain" HorizontalAlignment="Stretch" Margin="0,0,152,0">
                        <Grid.ColumnDefinitions>
                            <!-- （按用户要求改回居中）：Logo 在最左（col0），账号徽章紧跟其右（col1，靠左）；
                                 col2/col4 两列 1* 等宽平衡，把 col3 的切换按钮组推到整行居中；
                                 徽章宽度变化不再影响按钮居中。原 89 轮为「整组紧跟 Logo 左对齐」。 -->
                            <!-- （改真自适应）：右侧图标区（语言/最小化/关闭，占最右 112px）改由外层
                                 PanTitleMain 的右 margin 统一让出，不再用 col5 占位列（避免双重预留把按钮推偏）。
                                 于是本行只 4 列：Logo(Auto) | 账号徽章(Auto,靠左) | 1* | 按钮组(Auto,居中) | 1*，
                                 两个 1* 等宽把按钮组居中于「徽章右缘 → 图标区左缘」；窗口变窄时由代码
                                 AdaptTitleTabsToWidth 实测按钮组自然宽度、超出可用区就自动缩字号/间距。 -->
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Path x:Name="ShapeTitleLogo" Data="M26,29 v-25 h6 a7,7 180 0 1 0,14 h-6 M62.5,6.5 a10,11.5 180 1 0 0,18 M71,2.5 v24.5 h13.5" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="19,15.5,0,15.5" Stretch="fill" Stroke="White" StrokeThickness="2.2" Width="39" />
                        <TextBlock x:Name="LabTitleLogo" Visibility="Collapsed" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="18,0,0,0" Foreground="White" FontSize="17" VerticalAlignment="Center" />
                        <local:MyImage x:Name="ImageTitleLogo" SnapsToDevicePixels="False" UseLayoutRounding="False" IsHitTestVisible="False" HorizontalAlignment="Left" Margin="7" VerticalAlignment="Center" Visibility="Collapsed" />
                        <!-- 账号徽章：拆出 PanTitleSelect，单独占 col1（靠左，紧跟 Logo）；
                             与切换按钮组解耦后，按钮组可被 col2/col4 的 1* 等宽列推到整行严格居中 -->
                        <Border x:Name="BtnTitleAccount" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0"
                            CornerRadius="13" Background="#2EFFFFFF" Height="26" Cursor="Hand" Padding="5,3,10,3"
                            ToolTip="点击进入账户管理页面，可添加或切换账户">
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="3" ClipToBounds="True" Width="18" Height="18" VerticalAlignment="Center" Background="#33000000">
                                    <local:MyImage x:Name="ImgTitleAccount" Width="18" Height="18" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Border>
                                <TextBlock x:Name="LabTitleAccount" Text="" Margin="7,0,0,0" VerticalAlignment="Center" Foreground="White" FontSize="12.5" MaxWidth="110" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <!-- 切换按钮组：仅 5 个页面切换，被 col2/col4 居中 -->
                        <StackPanel Grid.Column="3" x:Name="PanTitleSelect" HorizontalAlignment="Center" Height="27" VerticalAlignment="Center" Orientation="Horizontal">
                            <local:MyRadioButton x:Name="BtnTitleSelect0" Text="启动" Tag="0" Margin="5,0" Checked="True" Padding="2,0" LogoScale="0.95" />
                            <local:MyRadioButton x:Name="BtnTitleSelect5" Text="实例" Tag="5" Margin="5,0" Padding="2,0" LogoScale="0.95" />
                            <local:MyRadioButton x:Name="BtnTitleSelect1" Text="下载" Tag="1" Margin="5,0" Padding="2,0" LogoScale="0.95" />
                            <local:MyRadioButton x:Name="BtnTitleSelect2" Text="联机" Tag="2" Margin="5,0" Padding="2,0" LogoScale="0.95" />
                            <local:MyRadioButton x:Name="BtnTitleSelect4" Text="更多" Tag="4" Margin="5,0" Padding="2,0" LogoScale="0.95" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="PanTitleInner" Visibility="Collapsed" Margin="-16,0,0,0" Opacity="0" HorizontalAlignment="Left" Width="{Binding ActualWidth, ElementName=PanTitle, Mode=OneWay}">
                        <local:MyIconButton HorizontalAlignment="Left" Theme="White" x:Name="BtnTitleInner" Margin="12,0,0,0" Height="28" Width="28"
                                             LogoScale="0.87" />
                        <TextBlock SnapsToDevicePixels="False" IsHitTestVisible="False" Name="LabTitleInner" VerticalAlignment="Center" Margin="47,1,60,0" HorizontalAlignment="Left" Foreground="{DynamicResource ColorBrush8}" FontSize="15" />
                    </Grid>
                </Grid>
                <Grid x:Name="PanLeft" Grid.Row="1" HorizontalAlignment="Left" SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="RectLeftBackground" Width="0" Fill="{DynamicResource ColorBrushBackgroundTransparentSidebar}" IsHitTestVisible="False" />
                    <Rectangle x:Name="RectLeftShadow" Width="4" HorizontalAlignment="Left" IsHitTestVisible="False" Grid.Column="1" >
                        <Rectangle.Fill>
                            <LinearGradientBrush EndPoint="1,0" StartPoint="0,0" Opacity="0.04">
                                <GradientStop Color="#000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <Grid x:Name="PanMain" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="1" Grid.IsSharedSizeScope="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Border x:Name="PanMainRight" RenderOptions.BitmapScalingMode="NearestNeighbor" UseLayoutRounding="False" SnapsToDevicePixels="False">
                        </Border>
                    </Border>
                    <Border Grid.IsSharedSizeScope="True" UseLayoutRounding="True" SnapsToDevicePixels="True">
                        <Border x:Name="PanMainLeft" RenderOptions.BitmapScalingMode="NearestNeighbor" UseLayoutRounding="False" SnapsToDevicePixels="False">
                        </Border>
                    </Border>
                </Grid>
                <!-- 右下角通知区（样式对照 PCL-CE-dev 的 MyToast）：底部留白由 MyToast.Show 按
                     PanExtraButtons 的实际高度动态调整为 extraHeight + 20，给右下角悬浮按钮让位；
                     可交互（关闭按钮 / 拖动关闭），故不再设 IsHitTestVisible="False" -->
                <StackPanel x:Name="PanHint" UseLayoutRounding="True" SnapsToDevicePixels="True" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,20" Grid.RowSpan="2" Panel.ZIndex="1" />
                <!-- 关闭 Minecraft：从右下角挪到左下角（用户要求「以后改成左边」）。
                     单独一个 StackPanel 是为了不牵动右下角那组按钮（返回顶部/任务管理/投降/音乐）的位置。 -->
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Grid.Row="1" Margin="15">
                    <!-- 巨型 Logo 几何（1.2~2.5KB 的 Path 字符串 ×4）已改为代码延迟赋值（ApplyExtraButtonLogos，
                         ）：这些按钮默认 Collapsed，BAML 解析阶段的 GeometryConverter 解析纯属白花。 -->
                    <local:MyExtraButton x:Name="BtnExtraShutdown" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip="关闭 Minecraft" Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="PanExtraButtons" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="1" Margin="15">
                    <local:MyExtraButton x:Name="BtnExtraBack" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="返回顶部" Visibility="Collapsed" />
                    <local:MyExtraButton x:Name="BtnExtraDownload" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="任务管理" Visibility="Collapsed"
                                       LogoScale="1.1" />
                    <local:MyExtraButton x:Name="BtnExtraApril" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="投降" Visibility="Collapsed" />
                    <local:MyExtraButton x:Name="BtnExtraMusic" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed" CanRightClick="True" />
                </StackPanel>
                <!--启动侧边栏宿主：PageLaunchRight 会在 Init 里把自己的 PanLaunching
                    移交到这里，这样侧边栏能盖住左边栏、真正从窗口最左边向右展开。
                    空的 Grid 没有背景，不占交互；弹窗层 PanMsg 在它上面。-->
                <Grid x:Name="HostLaunchSide" Grid.Row="1" />
                <Grid x:Name="PanMsg" Grid.RowSpan="2" Visibility="Collapsed">
                    <Grid.Background>
                        <SolidColorBrush Color="#01000000" />
                    </Grid.Background>
                </Grid>
            </Grid>
        </Border>
        <!-- （G1）：全局聚合搜索弹卡（Ctrl+K / 标题栏放大镜），首页「更多」卡片同款三段动画 -->
        <Popup x:Name="PopupGlobalSearch" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None" Placement="Center">
            <Border x:Name="CardGlobalSearch" Background="{DynamicResource ColorBrushCardBg}" CornerRadius="10" Padding="14,12" Margin="14"
                    Opacity="0" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="TransformGlobalSearchScale" ScaleX="0.94" ScaleY="0.94" />
                        <TranslateTransform x:Name="TransformGlobalSearchPos" X="0" Y="10" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="18" ShadowDepth="3" Opacity="0.35" RenderingBias="Performance" />
                </Border.Effect>
                <StackPanel Width="430">
                    <local:MyTextBox x:Name="TxtGlobalSearch" Height="34" HintText="搜索页面、实例与设置（Ctrl+K）" MaxLength="200" />
                    <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                        <StackPanel x:Name="PanGlobalSearch" />
                    </ScrollViewer>
                    <TextBlock x:Name="LabGlobalSearchEmpty" Text="没有匹配的结果" FontSize="12" Opacity="0.55" Margin="4,10,4,2" Visibility="Collapsed"
                               Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
