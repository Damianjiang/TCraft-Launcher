<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCraft" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSetupUI"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="36,20,36,28">
            <!-- Win11 风格页头：大标题 + 副标题，作为整页锚点 -->
            <StackPanel Margin="4,8,4,2">
                <TextBlock Text="个性化" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
                <TextBlock Text="主题、背景、声音与外观。每项改动即时生效。" FontSize="13" Opacity="0.55" Margin="0,6,0,0" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" />
            </StackPanel>
            <local:MyHint Theme="Blue" Margin="4,16,4,0"
                          Text="以下外观与配色选项仅对本机生效。&#xa;你可以随时切换主题、调整不透明度，或叠加自定义背景图片与背景音乐。" />

            <!-- 配色预览并入主题卡，颜色选择合并为一处（用户反馈：颜色应合并在一起） -->
            <local:MyCard Margin="0,24,0,0" Title="主题与配色" x:Name="CardLauncher">
                <Grid Margin="32,44,32,28">
                    <StackPanel>
                        <!-- 配色预览：当前主题强调色，切换主题后实时更新 -->
                        <TextBlock Text="主题的强调色会应用到按钮、滑块与选中态，切换后立即生效。" FontSize="12.5" Opacity="0.6" TextWrapping="Wrap" Margin="0,0,0,12" Foreground="{DynamicResource ColorBrush1}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource ColorBrush2}" Margin="0,0,12,0" />
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource ColorBrush3}" Margin="0,0,12,0" />
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource ColorBrush4}" Margin="0,0,12,0" />
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource ColorBrush5}" Margin="0,0,12,0" />
                            <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource ColorBrush6}" />
                        </StackPanel>
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="不透明度" Margin="0,0,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherTransparent" 
                                            MaxValue="600" ValueByKey="10" Grid.ColumnSpan="5" x:Name="SliderLauncherTransparent" Grid.Column="1" />
                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Name="LabLauncherHue" Visibility="Collapsed" HorizontalAlignment="Left" Text="色调" Margin="0,16,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherHue" 
                                            Grid.Row="1" Grid.Column="1" x:Name="SliderLauncherHue" Visibility="Collapsed" MaxValue="360" ValueByKey="10" Margin="0,16,0,0" />
                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Name="LabLauncherDelta" Visibility="Collapsed" HorizontalAlignment="Left" Text="色调渐变" Margin="0,16,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherDelta" 
                                            Grid.Row="2" Grid.Column="1" x:Name="SliderLauncherDelta" Visibility="Collapsed" MaxValue="180" ValueByKey="5" Margin="0,16,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Name="LabLauncherSat" Visibility="Collapsed" HorizontalAlignment="Left" Text="饱和度" Margin="0,16,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherSat" 
                                            Grid.Row="1" Grid.Column="4" x:Name="SliderLauncherSat" Visibility="Collapsed" MaxValue="100" ValueByKey="5" Margin="0,16,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="3" VerticalAlignment="Center" Name="LabLauncherLight" Visibility="Collapsed" HorizontalAlignment="Left" Text="亮度" Margin="0,16,20,0" />
                            <local:MySlider local:SettingService.Key="UiLauncherLight" 
                                            Grid.Row="2" Grid.Column="4" x:Name="SliderLauncherLight" Visibility="Collapsed" MaxValue="40" ValueByKey="5" Margin="0,16,0,0" />
                        </Grid>
                        <!-- 全部主题合并为一个流式 WrapPanel（原「主题 / 隐藏主题」两行拆分是历史
                             解锁彩蛋的遗留，如今所有主题均可直接选择，拆行徒增困惑）；单选项按内容自然宽度
                             摆放、自动换行，任何语言不截断。Key/Value/x:Name 与设置读写逻辑不变。 -->
                        <Grid x:Name="PanLauncherTheme" Margin="0,0,0,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Text="主题" Margin="0,2,20,0" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="0" Margin="0,0,18,10" Text="云溪蓝" x:Name="RadioLauncherTheme0" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="1" Margin="0,0,18,10" Text="竹露青" x:Name="RadioLauncherTheme1" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="2" Margin="0,0,18,10" Text="松涧绿" x:Name="RadioLauncherTheme2" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="3" Margin="0,0,18,10" Text="杏阳黄" x:Name="RadioLauncherTheme3" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="4" Margin="0,0,18,10" Text="檀木棕" x:Name="RadioLauncherTheme4" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="5" Margin="0,0,18,10" Text="墨夜黑" x:Name="RadioLauncherTheme5" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="6" Margin="0,0,18,10" Text="桃霞粉" x:Name="RadioLauncherTheme6" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="7" Margin="0,0,18,10" Text="星雾紫" x:Name="RadioLauncherTheme7" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="8" Margin="0,0,18,10" Text="暮霞金" x:Name="RadioLauncherTheme8" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="9" Margin="0,0,18,10" Text="熔岩橙" x:Name="RadioLauncherTheme9" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="10" Margin="0,0,18,10" Text="赤焰红" x:Name="RadioLauncherTheme10" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="11" Margin="0,0,18,10" Text="海盐蓝" x:Name="RadioLauncherTheme11" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="12" Margin="0,0,18,10" Text="七曜彩" x:Name="RadioLauncherTheme12" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="13" Margin="0,0,18,10" Text="曜光彩" x:Name="RadioLauncherTheme13" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="15" Margin="0,0,18,10" Text="青柠绿" x:Name="RadioLauncherTheme15" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="16" Margin="0,0,18,10" Text="薄荷绿" x:Name="RadioLauncherTheme16" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="17" Margin="0,0,18,10" Text="靛夜蓝" x:Name="RadioLauncherTheme17" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="18" Margin="0,0,18,10" Text="葡萄紫" x:Name="RadioLauncherTheme18" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="19" Margin="0,0,18,10" Text="雾霭蓝" x:Name="RadioLauncherTheme19" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="20" Margin="0,0,18,10" Text="玫瑰金" x:Name="RadioLauncherTheme20" />
                                <local:MyRadioBox local:SettingService.Key="UiLauncherTheme" local:SettingService.Value="14" Margin="0,0,18,10" Text="自定义" x:Name="RadioLauncherTheme14" />
                            </WrapPanel>
                        </Grid>
                        <local:MyCheckBox local:SettingService.Key="UiLauncherLogo" Text="打开启动器时显示 TCL 图标" Margin="-1,0,0,16" Height="22" />
                        <Grid Margin="0,0,0,20" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="组件半透明" Margin="0,0,20,0" />
                            <local:MySlider Grid.Column="1" local:SettingService.Key="UiComponentOpacity" MaxValue="100" ValueByKey="5"
                                            ToolTip="让卡片、列表项、提示框等组件变为半透明，可透出背景图，形成磨砂玻璃效果。&#13;0 为完全透明，100 为完全不透明；配合「背景图片 → 背景模糊」使用效果更佳。" />
                        </Grid>
                        <Grid Margin="0,0,0,0" Height="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="最大帧率" Margin="0,0,20,0" />
                            <local:MyComboBox Grid.Column="1" local:SettingService.Key="UiMaxFps" ToolTip="限制启动器界面的最大帧率，降低帧率可以减少 CPU 与 GPU 占用。">
                                <local:MyComboBoxItem local:SettingService.Value="0" Content="不限制" />
                                <local:MyComboBoxItem local:SettingService.Value="30" Content="30 FPS" />
                                <local:MyComboBoxItem local:SettingService.Value="60" Content="60 FPS" />
                                <local:MyComboBoxItem local:SettingService.Value="90" Content="90 FPS" />
                                <local:MyComboBoxItem local:SettingService.Value="120" Content="120 FPS" />
                                <local:MyComboBoxItem local:SettingService.Value="144" Content="144 FPS" />
                                <local:MyComboBoxItem local:SettingService.Value="240" Content="240 FPS" />
                            </local:MyComboBox>
                        </Grid>
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <!-- 弹出菜单细化设置（动画开关 + 卡片不透明度；作用于全部右键/「更多」弹卡与全局搜索卡） -->
            <local:MyCard Margin="0,24,0,0" Title="弹出菜单">
                <StackPanel Margin="32,44,32,24">
                    <local:MyCheckBox local:SettingService.Key="UiMenuAnimation" Text="启用弹出菜单动画效果" Height="22" Margin="-1,0,0,14"
                                      ToolTip="关闭后，右键菜单、「更多」弹卡与全局搜索（Ctrl+K）将直接显示/消失，不再播放过渡动画。" />
                    <Grid Height="36" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="弹出菜单不透明度" Margin="0,0,20,0" />
                        <local:MySlider Grid.Column="1" local:SettingService.Key="UiMenuOpacity" MaxValue="100" ValueByKey="5"
                                        ToolTip="100 为完全不透明；调低可让弹出菜单微微透出背景。&#13;此处单独控制弹出菜单，与下方「组件半透明」互不影响。" />
                    </Grid>
                    <TextBlock Text="说明：弹出菜单卡片独立于「组件半透明」——组件半透明作用于全局卡片，这里只调右键菜单与弹卡。" FontSize="12" Opacity="0.55" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
            </local:MyCard>
            <!-- 列表按钮常驻显示（版本/实例/存档/Mod/Java/下载等所有列表行右侧按钮） -->
            <local:MyCard Margin="0,24,0,0" Title="列表按钮">
                <StackPanel Margin="32,44,32,24">
                    <local:MyCheckBox local:SettingService.Key="UiListButtonsAlwaysShow" Text="所有列表的操作按钮常驻显示" Height="22" Margin="-1,0,0,12"
                                      ToolTip="默认只有鼠标悬停在列表行上，右侧的收藏 / 设置 / 更多等按钮才会浮现。&#13;勾选后，版本列表、实例列表、存档、Mod、Java、下载等全部列表始终显示按钮；触摸屏或不习惯悬停时更顺手。切换后立即生效，无需重启。" />
                    <TextBlock Text="说明：开启后按钮会一直占住右侧空间，列表标题可显示的宽度会略微变窄。" FontSize="12" Opacity="0.55" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
            </local:MyCard>
            <!--界面细节（圆角 / 标题栏 / 动画速度 / 账户徽章 / 启动动画）-->
            <local:MyCard x:Name="CardDetail" Margin="0,24,0,0" Title="界面细节">
                <StackPanel Margin="32,44,32,26">
                    <Grid Height="44" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="窗口圆角" Margin="0,0,25,0" />
                        <local:MySlider Grid.Column="1" local:SettingService.Key="UiWindowRadius" x:Name="SliderWindowRadius" MaxValue="24"
                                        ToolTip="启动器四个角的圆角半径，0 为直角，默认 6。拖动时窗口会立刻变化。" />
                    </Grid>
                    <Grid Height="44" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="标题栏高度" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Column="1" local:SettingService.Key="UiTitleBarHeight" ToolTip="顶部标题栏的高度，屏幕较小时调低可以多留出内容区。">
                            <local:MyComboBoxItem local:SettingService.Value="40" Content="40" />
                            <local:MyComboBoxItem local:SettingService.Value="44" Content="44" />
                            <local:MyComboBoxItem local:SettingService.Value="48" Content="48（默认）" />
                            <local:MyComboBoxItem local:SettingService.Value="54" Content="54" />
                            <local:MyComboBoxItem local:SettingService.Value="60" Content="60" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid Height="44" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="动画速度" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Column="1" local:SettingService.Key="SystemDebugAnim"
                                          ToolTip="调整界面过渡动画的快慢。选「关闭」后翻页、卡片展开等动画瞬间完成，低配电脑更跟手。">
                            <local:MyComboBoxItem local:SettingService.Value="30" Content="关闭（瞬间完成）" />
                            <local:MyComboBoxItem local:SettingService.Value="5" Content="较慢" />
                            <local:MyComboBoxItem local:SettingService.Value="9" Content="标准（默认）" />
                            <local:MyComboBoxItem local:SettingService.Value="14" Content="较快" />
                            <local:MyComboBoxItem local:SettingService.Value="20" Content="极快" />
                        </local:MyComboBox>
                    </Grid>
                    <local:MyCheckBox local:SettingService.Key="UiTitleAccountBadge" Text="在标题栏显示账户头像与名字" Margin="-1,4,0,14" Height="22"
                                      ToolTip="关掉后标题栏只保留页面切换按钮，适合截图或不想让别人看到账户名时使用。" />
                    <local:MyCheckBox local:SettingService.Key="UiRememberWindowPos" Text="记住窗口位置" Margin="-1,0,0,14" Height="22"
                                      ToolTip="开启后，下次启动会回到上次关闭时窗口所在的位置；如果那块屏幕已经不存在，会自动退回居中。" />
                    <local:MyCheckBox local:SettingService.Key="UiSkipIntroAnim" Text="跳过启动时的窗口入场动画（下次启动生效）" Margin="-1,0,0,0" Height="22"
                                      ToolTip="启动时直接显示完整窗口，不再有淡入、上移与旋转。在软件渲染（远程桌面、无独显）下大约能省 0.5 秒。" />
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardBackground" Margin="0,24,0,0" Title="背景">
                <StackPanel Margin="32,44,32,26">
                    <Grid Height="44" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="背景类型" Margin="0,0,25,0" ToolTip="两者只能选其一：图片为静态背景，视频为动态背景。切换后立即生效。" />
                        <local:MyComboBox local:SettingService.Key="UiBackgroundType" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="图片（静态背景）" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="视频（动态背景）" />
                        </local:MyComboBox>
                    </Grid>
                    <StackPanel x:Name="PanBackgroundImage">
                    <Grid x:Name="PanBackgroundSuit" Height="44" Margin="0,0,0,16" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="自适应方式" Margin="0,0,25,0" />
                        <local:MyComboBox local:SettingService.Key="UiBackgroundSuit" Grid.Column="1">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="自动" ToolTip="当图片较小时选择平铺，较大时选择居中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="4" Content="平铺" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="居中" />
                            <local:MyComboBoxItem local:SettingService.Value="3" Content="拉伸" ToolTip="拉伸图片使其恰好填满整个窗口，很可能会导致长宽比的改变" />
                            <local:MyComboBoxItem local:SettingService.Value="5" Content="左上 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="9" Content="左中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="7" Content="左下 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="11" Content="中上 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="2" Content="居中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="12" Content="中下 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="6" Content="右上 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="10" Content="右中 (保持长宽比)" />
                            <local:MyComboBoxItem local:SettingService.Value="8" Content="右下 (保持长宽比)" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid x:Name="PanBackgroundRotate" Height="44" Margin="0,0,0,16" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="自动轮播" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Column="1" local:SettingService.Key="UiBackgroundRotate"
                                          ToolTip="每隔一段时间从背景图片文件夹里随机换一张。轮播仅在「图片」背景下生效，视频背景不会被替换。">
                            <local:MyComboBoxItem local:SettingService.Value="0" Content="关闭" />
                            <local:MyComboBoxItem local:SettingService.Value="1" Content="每 1 分钟" />
                            <local:MyComboBoxItem local:SettingService.Value="5" Content="每 5 分钟" />
                            <local:MyComboBoxItem local:SettingService.Value="15" Content="每 15 分钟" />
                            <local:MyComboBoxItem local:SettingService.Value="30" Content="每 30 分钟" />
                            <local:MyComboBoxItem local:SettingService.Value="60" Content="每 60 分钟" />
                        </local:MyComboBox>
                    </Grid>
                    <Grid x:Name="PanBackgroundOpacity" Height="34" Margin="0,0,0,16" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="不透明度" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiBackgroundOpacity" x:Name="SliderBackgroundOpacity" MaxValue="1000" ValueByKey="10" Grid.Column="1" />
                    </Grid>
                    <Grid x:Name="PanBackgroundBlur" Height="34" Margin="0,0,0,16" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="背景模糊" Margin="0,0,25,0" />
                        <local:MySlider local:SettingService.Key="UiBackgroundBlur" x:Name="SliderBackgroundBlur" MaxValue="40" Grid.Column="1" 
                                        ToolTip="高度的模糊会严重掉帧，请谨慎。&#13;不建议在制作整合包时开启模糊，以确保 TCL 在低性能电脑上可以流畅运行。" />
                    </Grid>
                    <local:MyCheckBox local:SettingService.Key="UiBackgroundColorful" Text="叠加彩色背景" Margin="-1,0,0,14" Height="22" />
                    <local:MyCheckBox local:SettingService.Key="UiAutoThemeFromBackground" Text="根据背景图自动调整主题色" Margin="-1,0,0,14" Height="22"
                                      ToolTip="从背景图片中提取主色调，让启动器的整套配色自动跟随壁纸（HMCL 动态取色同款体验）。手动选择其他主题后此功能对当前背景失效，刷新背景图后重新生效。" />
                    <Grid Height="40" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnBackgroundOpen" MinWidth="140" Text="打开文件夹" Padding="13,0" Margin="0,0,20,0" ToolTip="将背景图片放到该文件夹，TCL 将会在每次打开时随机加载其中的一张图片"/>
                        <local:MyButton x:Name="BtnBackgroundRefresh" MinWidth="140" Text="刷新背景图片" Padding="13,0" Margin="0,0,20,0" ToolTip="随机加载文件夹内的一张背景图片" Grid.Column="1"/>
                        <local:MyButton x:Name="BtnBackgroundClear" MinWidth="140" Text="清空背景图片" Visibility="Collapsed" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="2"/>
                    </Grid>
                    </StackPanel>
                    <StackPanel x:Name="PanVideoSettings" Visibility="Collapsed">
                    <Grid x:Name="PanVideoVolume" Visibility="Collapsed" Height="34" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="音量" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderVideoVolume" local:SettingService.Key="UiVideoVolume" MaxValue="1000" ValueByKey="10" Grid.Column="1" />
                    </Grid>
                    <StackPanel x:Name="PanVideoDetail" Visibility="Collapsed" Margin="-1,0,0,4">
                        <local:MyCheckBox Text="随机播放" Margin="0,0,0,12" Height="22" x:Name="CheckVideoRandom" local:SettingService.Key="UiVideoRandom" />
                        <local:MyCheckBox Text="静音（仅作为背景画面）" Margin="0,0,0,12" Height="22" x:Name="CheckVideoMute" local:SettingService.Key="UiVideoMute" />
                    </StackPanel>
                    <Grid Height="40" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnVideoOpen" Text="打开文件夹" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ToolTip="将背景视频（mp4/wmv/mov/mkv/avi/webm）放到该文件夹，TCL 将循环播放其中的所有视频。配合「组件半透明」可透出动态磨砂背景"/>
                        <local:MyButton x:Name="BtnVideoRefresh" Text="刷新背景视频" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ToolTip="重新扫描视频文件夹，并播放其中的视频" Grid.Column="1"/>
                        <local:MyButton x:Name="BtnVideoClear" Text="清空背景视频" MinWidth="140" Visibility="Collapsed" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="2"/>
                    </Grid>
                    </StackPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardMusic" Margin="0,24,0,0" Title="背景音乐">
                <StackPanel Margin="32,44,32,26">
                    <Grid x:Name="PanMusicVolume" Visibility="Collapsed" Height="34" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="音量" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderMusicVolume" local:SettingService.Key="UiMusicVolume" MaxValue="1000" ValueByKey="10" Grid.Column="1" />
                    </Grid>
                    <StackPanel x:Name="PanMusicDetail" Visibility="Collapsed" Margin="-1,0,0,4">
                        <local:MyCheckBox Text="随机播放" Margin="0,0,0,12" Height="22" x:Name="CheckMusicRandom" local:SettingService.Key="UiMusicRandom" />
                        <local:MyCheckBox Text="打开启动器自动开始播放" Margin="0,0,0,12" Height="22" x:Name="CheckMusicAuto" local:SettingService.Key="UiMusicAuto" />
                        <local:MyCheckBox Text="游戏启动后自动开始播放，游戏退出后自动暂停播放" Margin="0,0,0,12" Height="22" x:Name="CheckMusicStart" local:SettingService.Key="UiMusicStart" />
                        <local:MyCheckBox Text="游戏启动后自动暂停播放，游戏退出后自动开始播放" Margin="0,0,0,12" Height="22" x:Name="CheckMusicStop" local:SettingService.Key="UiMusicStop" />
                    </StackPanel>
                    <Grid Height="40" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnMusicOpen" Text="打开文件夹" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ToolTip="将背景音乐放到该文件夹，TCL 将会播放其中的所有音乐"/>
                        <local:MyButton x:Name="BtnMusicRefresh" Text="刷新背景音乐" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ToolTip="刷新播放列表，并播放列表中的音乐" Grid.Column="1"/>
                        <local:MyButton x:Name="BtnMusicClear" Text="清空背景音乐" MinWidth="140" Visibility="Collapsed" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="2"/>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardFont" Margin="0,24,0,0" Title="自定义字体">
                <StackPanel Margin="32,44,32,26">
                    <TextBlock Margin="0,0,0,16" TextWrapping="Wrap" FontSize="13" Opacity="0.7" Foreground="{DynamicResource ColorBrush1}"
                        Text="把 .ttf / .otf 字体放进「字体文件夹」，TCL 启动时自动应用并记住；也可点「选择字体文件」挑选，会自动存进文件夹。下次打开自动生效。" />
                    <Border Margin="0,0,0,18" Padding="20,16" CornerRadius="10" Background="{DynamicResource ColorBrush8}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LabFontPreview" FontSize="26" FontWeight="SemiBold" Text="Aa Bb Cc 字体预览 123" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock x:Name="LabFontName" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="12" Foreground="Gray" Text="当前：系统默认字体" />
                        </Grid>
                    </Border>
                    <Grid Height="40" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnFontPick" Text="选择字体文件" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ToolTip="挑选 .ttf / .otf 字体文件，自动存到字体文件夹并立即应用" />
                        <local:MyButton x:Name="BtnFontRefresh" Text="刷新字体" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ToolTip="重新扫描字体文件夹，应用其中一个字体" Grid.Column="1"/>
                        <local:MyButton x:Name="BtnFontOpen" Text="打开字体文件夹" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ToolTip="将 .ttf / .otf 字体文件放到该文件夹，TCL 每次启动自动应用" Grid.Column="2"/>
                        <local:MyButton x:Name="BtnFontReset" Text="恢复默认" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ColorType="Red" ToolTip="恢复系统默认字体" Grid.Column="3"/>
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardLogo" Margin="0,24,0,0" Title="标题栏">
                <StackPanel Margin="32,44,32,24">
                    <!-- 第 N 轮：标题栏类型原为 5 列固定比例 Grid，窄窗口下挤成「…」。改 WrapPanel 横排、窄了自动换行。 -->
                    <WrapPanel Margin="-1,0,0,0">
                        <local:MyRadioBox Text="无" x:Name="RadioLogoType0" Height="22" local:SettingService.Key="UiLogoType" local:SettingService.Value="0" Margin="0,0,18,10" />
                        <local:MyRadioBox Text="默认" x:Name="RadioLogoType1" Height="22" local:SettingService.Key="UiLogoType" local:SettingService.Value="1" Margin="0,0,18,10" />
                        <local:MyRadioBox Text="文本" x:Name="RadioLogoType2" Height="22" local:SettingService.Key="UiLogoType" local:SettingService.Value="2" Margin="0,0,18,10" />
                        <local:MyRadioBox Text="图片" x:Name="RadioLogoType3" Height="22" local:SettingService.Key="UiLogoType" local:SettingService.Value="3" Margin="0,0,18,10" />
                    </WrapPanel>
                    <local:MyCheckBox Text="标题栏居左" Margin="-1,12,0,4" Height="22" x:Name="CheckLogoLeft" local:SettingService.Key="UiLogoLeft" Visibility="Collapsed" />
                    <Grid x:Name="PanLogoText" Margin="0,20,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="标题栏文本" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextLogoText" local:SettingService.Key="UiLogoText" Grid.Column="1" MaxLength="100" />
                    </Grid>
                    <Grid x:Name="PanLogoChange" Margin="0,20,0,8" Height="40" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnLogoChange" Text="更改图片" MinWidth="140" Padding="13,0" Margin="0,0,20,0" />
                        <local:MyButton x:Name="BtnLogoDelete" Text="清空图片" MinWidth="140" Padding="13,0" Margin="0,0,20,0" ColorType="Red" Grid.Column="1" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard x:Name="CardSwitch" Margin="0,24,0,0" Title="功能隐藏">
                <StackPanel Margin="32,42,32,24">
                    <TextBlock Margin="0,2,0,4" Text="你可以隐藏不需要的页面或关闭特定功能。隐藏将在下次启动时自动恢复。" TextWrapping="Wrap" Opacity="0.7" FontSize="13" />
                    <!-- 第 N 轮：原为 7 列固定比例 Grid（0.8*/0.9*…），窄窗口下复选框文字被裁成「邮箱…/Mod…」。
                         改为「标签列 + WrapPanel 流式列」：标签左对齐成组，复选框随宽度自动换行、永不裁剪；
                         所有 x:Name 与 SettingService.Key 原样保留（.vb 里 HiddenSetupSub 等按名字引用）。 -->
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 主页面 -->
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="主页面" />
                        <WrapPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="下载" x:Name="CheckHiddenPageDownload" local:SettingService.Key="UiHiddenPageDownload" />
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="联机" x:Name="CheckHiddenPageLink" local:SettingService.Key="UiHiddenPageLink" />
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="设置" x:Name="CheckHiddenPageSetup" local:SettingService.Key="UiHiddenPageSetup" />
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="更多" x:Name="CheckHiddenPageOther" local:SettingService.Key="UiHiddenPageOther" />
                        </WrapPanel>

                        <!-- 设置 子页面 -->
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Text="设置 子页面" Margin="0,14,0,0" />
                        <WrapPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="启动" x:Name="CheckHiddenSetupLaunch" local:SettingService.Key="UiHiddenSetupLaunch" />
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="联机" x:Name="CheckHiddenSetupLink" local:SettingService.Key="UiHiddenSetupLink" />
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="个性化" x:Name="CheckHiddenSetupUI" local:SettingService.Key="UiHiddenSetupUi" />
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="其他" x:Name="CheckHiddenSetupSystem" local:SettingService.Key="UiHiddenSetupSystem" />
                        </WrapPanel>

                        <!-- 更多 子页面 -->
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="更多 子页面" Margin="0,14,0,0" />
                        <WrapPanel Grid.Row="2" Grid.Column="2" VerticalAlignment="Center">
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="关于" x:Name="CheckHiddenOtherAbout" local:SettingService.Key="UiHiddenOtherAbout" />
                        </WrapPanel>

                        <!-- 特定功能 -->
                        <TextBlock Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Left" Text="特定功能" Margin="0,14,0,0" />
                        <WrapPanel Grid.Row="3" Grid.Column="2" VerticalAlignment="Center">
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="邮箱隐藏" x:Name="CheckLauncherEmail" local:SettingService.Key="UiLauncherEmail" ToolTip="隐藏第三方登录的账号邮箱显示，以避免隐私泄露。&#xa;此选项的更改将在重启启动器后生效。" />
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="版本管理" x:Name="CheckHiddenFunctionSelect" local:SettingService.Key="UiHiddenFunctionSelect" ToolTip="隐藏启动按钮下方的版本选择与版本设置入口。" />
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="Mod 更新" x:Name="CheckHiddenFunctionModUpdate" local:SettingService.Key="UiHiddenFunctionModUpdate" ToolTip="禁止在 Mod 管理页面更新 Mod。" />
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="功能隐藏" x:Name="CheckHiddenFunctionHidden" local:SettingService.Key="UiHiddenFunctionHidden" ToolTip="仅隐藏本选项卡，设置的禁用内容依然有效。&#xa;可以在保留个性化设置页面的情况下避免隐藏设置被修改。" />
                            <local:MyCheckBox Height="22" VerticalAlignment="Center" Margin="0,4,18,4" Text="版本修改" x:Name="CheckHiddenFunctionModify" local:SettingService.Key="UiHiddenFunctionInstanceModify" ToolTip="隐藏版本设置中的版本修改功能。" />
                        </WrapPanel>
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
