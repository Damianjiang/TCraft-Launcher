<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCraft" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d" x:Class="PageSetupSystem"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="36,20,36,28">
            <!-- Win11 风格页头 -->
            <StackPanel Margin="4,8,4,2">
                <TextBlock Text="系统" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
                <TextBlock Text="下载、网络、语言与启动器行为。" FontSize="13" Opacity="0.55" Margin="0,6,0,0" Foreground="{DynamicResource ColorBrush1}" />
            </StackPanel>
            <local:MyCard Margin="0,24,0,0" Title="下载">
                <StackPanel Margin="32,44,32,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="文件下载源" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDownloadSource" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadSource" Grid.Column="1">
                            <local:MyComboBoxItem Content="尽量使用镜像源" />
                            <local:MyComboBoxItem Content="优先使用官方源，在加载缓慢时换用镜像源" IsSelected="True" />
                            <local:MyComboBoxItem Content="尽量使用官方源" />
                        </local:MyComboBox>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="版本列表源" Margin="0,0,25,0" Grid.Row="2" />
                        <local:MyComboBox x:Name="ComboDownloadVersion" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadVersion" Grid.Column="1" Grid.Row="2">
                            <local:MyComboBoxItem Content="尽量使用镜像源（可能缺少刚刚更新的版本）" />
                            <local:MyComboBoxItem Content="优先使用官方源，在加载缓慢时换用镜像源" IsSelected="True" />
                            <local:MyComboBoxItem Content="尽量使用官方源" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="最大线程数" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDownloadThread" Grid.Row="4" local:SettingService.Key="ToolDownloadThread" MaxValue="255" Value="63" Grid.Column="1"
                                        ToolTip="线程数越多，限速的文件下载越快，但过高的线程数会造成下载时非常严重的卡顿。&#xa;一般而言，64 线程已可以保证足够的下载速度。" />
                        <TextBlock VerticalAlignment="Center" Grid.Row="5" HorizontalAlignment="Left" Text="速度限制" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDownloadSpeed" Grid.Row="5" local:SettingService.Key="ToolDownloadSpeed" MaxValue="42" Value="42" Grid.Column="1"
                                        ToolTip="设置下载的速度上限，以避免在下载时导致其他需要联网的程序卡死" />
                        <TextBlock VerticalAlignment="Top" Grid.Row="6" HorizontalAlignment="Left" Text="目标文件夹" Margin="0,5,25,5" />
                        <TextBlock Margin="0,5" HorizontalAlignment="Left" Text="请在 启动 → 版本选择 → 文件夹列表 中更改下载目标文件夹。&#xa;在某个文件夹或游戏版本上右键，即可选择打开对应文件夹。" Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Opacity="0.5" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,24,0,0" Title="社区资源">
                <StackPanel Margin="32,44,32,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="36" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left" Text="来源" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboDownloadMod" Grid.Row="0" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadMod" Grid.Column="1">
                            <local:MyComboBoxItem Content="尽量使用镜像源（可能缺少刚刚更新的版本）" />
                            <local:MyComboBoxItem Content="仅在官方源加载缓慢时改用镜像源" />
                            <local:MyComboBoxItem Content="尽量使用官方源" IsSelected="True" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="文件名格式" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="2" x:Name="ComboDownloadTranslateV2" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadTranslateV2" Grid.Column="1" 
                                          ToolTip="下载社区资源时，其默认文件名的格式">
                            <local:MyComboBoxItem Content="【机械动力】create-1.21.1-6.0.4" />
                            <local:MyComboBoxItem Content="[机械动力] create-1.21.1-6.0.4" IsSelected="True" />
                            <local:MyComboBoxItem Content="机械动力-create-1.21.1-6.0.4" />
                            <local:MyComboBoxItem Content="create-1.21.1-6.0.4-机械动力" />
                            <local:MyComboBoxItem Content="create-1.21.1-6.0.4" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="Mod 管理样式" Margin="0,0,25,0" />
                        <local:MyComboBox Grid.Row="4" x:Name="ComboModLocalNameStyle" Grid.ColumnSpan="2" local:SettingService.Key="ToolModLocalNameStyle" Grid.Column="1" 
                                          ToolTip="在 Mod 管理页面中，Mod 项的显示方式">
                            <local:MyComboBoxItem Content="标题显示译名，详情显示文件名" IsSelected="True" />
                            <local:MyComboBoxItem Content="标题显示文件名，详情显示译名" />
                        </local:MyComboBox>
                        <TextBlock Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Left" Text="CurseForge Key" Margin="0,0,25,0" />
                        <local:MyTextBox x:Name="TextCurseForgeKey" Grid.Row="6" Grid.ColumnSpan="2" local:SettingService.Key="ToolDownloadCurseForgeKey" Grid.Column="1"
                                         HintText="默认"
                                         ToolTip="CurseForge 的 API 需要密钥才能查询世界 / 模组 / 整合包列表，缺失时这些列表会为空。&#xa;在 https://console.curseforge.com/ 的 API 标签页生成后填入，保存后重启 TCL 生效。&#xa;留空则回退到环境变量 TCL_CURSEFORGE_API_KEY。" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,24,0,0" Title="网络">
                <Grid Margin="32,44,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="30" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="HTTP 代理" Margin="0,0,25,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <local:MyRadioBox local:SettingService.Key="SystemHttpProxyType" local:SettingService.Value="0" x:Name="RadioHttpProxy0" Text="不代理" Height="22" Margin="0,0,20,0"
                                          ToolTip="TCL 的所有网络请求（下载、登录、API）均不经过代理" />
                        <local:MyRadioBox local:SettingService.Key="SystemHttpProxyType" local:SettingService.Value="1" x:Name="RadioHttpProxy1" Text="系统代理" Height="22" Margin="0,0,20,0" Checked="True"
                                          ToolTip="跟随 Windows 系统当前的代理设置（如 Clash、v2rayN 等代理工具配置的系统代理）" />
                        <local:MyRadioBox local:SettingService.Key="SystemHttpProxyType" local:SettingService.Value="2" x:Name="RadioHttpProxy2" Text="自定义代理" Height="22"
                                          ToolTip="使用下方填写的代理地址" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="代理地址" Margin="0,0,25,0" />
                    <local:MyTextBox Grid.Row="2" Grid.Column="1" x:Name="TextHttpProxy" local:SettingService.Key="SystemHttpProxy"
                                     HintText="例如：127.0.0.1:1080"
                                     ToolTip="仅在 自定义代理 模式下使用。&#xa;支持 127.0.0.1:1080 或 http://127.0.0.1:1080 两种格式。" />
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left" Text="账号" Margin="0,0,25,0" />
                    <local:MyTextBox Grid.Row="4" Grid.Column="1" x:Name="TextHttpProxyUsername" local:SettingService.Key="SystemHttpProxyCustomUsername"
                                     HintText="可选" ToolTip="仅在 自定义代理 模式下使用，若代理需要身份验证则填写。" />
                    <TextBlock Grid.Row="6" VerticalAlignment="Center" HorizontalAlignment="Left" Text="密码" Margin="0,0,25,0" />
                    <local:MyTextBox Grid.Row="6" Grid.Column="1" x:Name="TextHttpProxyPassword" local:SettingService.Key="SystemHttpProxyCustomPassword"
                                     HintText="可选" ToolTip="仅在 自定义代理 模式下使用。" />
                    <local:MyCheckBox Grid.Row="8" Grid.Column="1" x:Name="CheckHttpProxyForGame" local:SettingService.Key="SystemHttpProxyForGame" Height="22"
                                      Text="启动游戏时使用此代理"
                                      ToolTip="开启后，自定义代理将同时传递给游戏（JVM 参数），使游戏内访问 Mojang 服务器、下载资源等也走代理。" />
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,24,0,0" Title="辅助功能">
                <Grid Margin="32,44,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="30" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="游戏更新提示" Margin="0,0,25,0" />
                    <local:MyCheckBox Text="正式版更新提示" Grid.Column="1" x:Name="CheckUpdateRelease" local:SettingService.Key="ToolUpdateRelease" ToolTip="在 Minecraft 正式版更新时弹窗提示" />
                    <local:MyCheckBox Text="测试版更新提示" Grid.Column="2" Height="22" x:Name="CheckUpdateSnapshot" local:SettingService.Key="ToolUpdateSnapshot" ToolTip="在 Minecraft 测试版（快照、预发布版）更新时弹窗提示" />
                    <TextBlock VerticalAlignment="Center" Grid.Row="2" HorizontalAlignment="Left" Text="游戏语言" Margin="0,0,25,0" />
                    <local:MyCheckBox Text="自动设置为中文" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5" x:Name="CheckHelpChinese" local:SettingService.Key="ToolHelpChinese" />
                    <TextBlock VerticalAlignment="Center" Grid.Row="4" HorizontalAlignment="Left" Text="正版购买提示" Margin="0,0,25,0" />
                    <local:MyCheckBox Text="不再提示「考虑一下正版」" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5" Height="22" x:Name="CheckHintBuy" local:SettingService.Key="HintBuy" ToolTip="取消勾选后，启动游戏达到一定次数时会弹窗建议你支持正版。&#xa;勾选后不再提示（登录一次正版账号也会自动停止提示）。" />
                    <TextBlock VerticalAlignment="Center" Grid.Row="6" HorizontalAlignment="Left" Text="语言" Margin="0,0,25,0" />
                    <local:MyComboBox x:Name="ComboLanguage" Grid.Row="6" Grid.Column="1" local:SettingService.Key="ToolLanguage" ToolTip="设置界面语言与部分日期、数字等文化相关显示。&#xa;「自动识别」按系统当前语言就近选择简中 / 繁中 / 英文。&#xa;「文言文」为一种文风选项，采用半文半白、雅致工整的表达。">
                        <local:MyComboBoxItem Content="简体中文" local:SettingService.Value="0" IsSelected="True" />
                        <local:MyComboBoxItem Content="English" local:SettingService.Value="1" />
                        <local:MyComboBoxItem Content="繁體中文" local:SettingService.Value="2" />
                        <local:MyComboBoxItem Content="文言文" local:SettingService.Value="3" />
                        <local:MyComboBoxItem Content="自动识别系统语言" local:SettingService.Value="4" />
                    </local:MyComboBox>
                    <TextBlock VerticalAlignment="Center" Grid.Row="8" HorizontalAlignment="Left" Text="翻译文件" Margin="0,0,25,0" ToolTip="所有界面文案统一由单个文件 i18n.json（TCL\i18n.json）管理，启动时自动生成。直接用文本编辑器修改该文件后点「重载」即可即时生效（无需重启）。" />
                    <local:MyButton Grid.Row="8" Grid.Column="1" x:Name="BtnExportI18n" MinWidth="100" Text="导出" Padding="13,0" Margin="0,0,12,0" ToolTip="把当前全部译文（内置 + 已自定义）写入 i18n.json。" />
                    <local:MyButton Grid.Row="8" Grid.Column="2" x:Name="BtnReloadI18n" MinWidth="100" Text="重载" Padding="13,0" Margin="0,0,12,0" ToolTip="重新读取 i18n.json 并即时套用到界面（无需重启）。" />
                    <local:MyButton Grid.Row="8" Grid.Column="3" x:Name="BtnOpenI18n" MinWidth="100" Text="打开文件" Padding="13,0" ToolTip="用默认文本编辑器打开 i18n.json 直接编辑。" />
                </Grid>
            </local:MyCard>
            <local:MyCard Margin="0,24,0,0" Title="启动器">
                <Grid Margin="32,44,32,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="36" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="启动器公告" Margin="0,0,25,0" />
                    <local:MyComboBox x:Name="ComboSystemActivity" local:SettingService.Key="SystemSystemActivity" Grid.Column="1">
                        <local:MyComboBoxItem Content="显示所有公告" ToolTip="显示包括启动器功能调查、活动等在内的全部公告" />
                        <local:MyComboBoxItem Content="仅在有重要通知时显示公告" />
                        <local:MyComboBoxItem Content="关闭所有公告" />
                    </local:MyComboBox>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left" Text="缓存文件夹" Margin="0,0,25,0" />
                    <local:MyTextBox x:Name="TextSystemCache" Grid.Row="2" Grid.ColumnSpan="2" local:SettingService.Key="SystemSystemCache" Grid.Column="1" ToolTip="TCL 的下载、皮肤等缓存文件的存储位置。&#xa;不推荐路径中带有空格。&#xa;留空即为默认值，重启 TCL 后生效。" HintText="默认">
                        <local:MyTextBox.ValidateRules>
                            <local:ValidateNullable />
                            <local:ValidateFolderPath UseMinecraftCharCheck="False" />
                        </local:MyTextBox.ValidateRules>
                    </local:MyTextBox>
                    <local:MyCheckBox Margin="0,4,0,0" Text="禁用硬件加速（软件渲染）" Grid.Row="4" Height="22" Grid.ColumnSpan="2"
                        x:Name="CheckSystemHwAccelerate" local:SettingService.Key="SystemDisableHardwareAcceleration"
                        ToolTip="使用 WPF 软件渲染界面，重启 TCL 后生效。&#xa;若界面出现卡顿、花屏或显卡驱动异常时可尝试开启。" />
                    <Grid Height="40" Grid.Row="5" Grid.ColumnSpan="5" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton Grid.Column="0" x:Name="BtnSystemSettingExp" MinWidth="140" Text="导出全部数据" Padding="13,0" Margin="0,0,20,0"
                                        ToolTip="导出全局设置、每个实例的独立设置、合集清单与登录缓存（含加密后的账户凭据），保存为单个 .tcl 文件。&#xa;不包含背景图、皮肤等大体积媒体文件。" />
                        <local:MyButton Grid.Column="1" x:Name="BtnSystemSettingImp" MinWidth="140" Text="导入全部数据" Padding="13,0" Margin="0,0,20,0"
                                        ToolTip="从 .tcl 导出文件恢复全部数据。多数设置导入后立即生效，少数（如缓存文件夹路径）将在重启 TCL 后完全生效。" />
                        <local:MyButton Grid.Column="2" x:Name="BtnSystemIdentify" MinWidth="140" Text="复制识别码" Padding="13,0" Margin="0,0,20,0" />
                        <!-- 第 129 轮：导入在后台线程执行，期间显示加载动画并禁用按钮 -->
                        <local:MyLoading Grid.Column="3" x:Name="LoadingImport" Visibility="Collapsed" Text="正在导入数据…" Height="30" HorizontalAlignment="Left" Margin="4,0,0,0" />
                    </Grid>
                    <Grid Height="40" Grid.Row="6" Grid.ColumnSpan="5" Margin="0,16,0,0" x:Name="PanDonate">
                        <local:MyButton x:Name="BtnSystemUnlock" MinWidth="140" Text="输入番茄码" Padding="13,0" Margin="0,0,20,0" />
                    </Grid>
                </Grid>
            </local:MyCard>

            <!-- <local:MyCard x:Name="CardMain" Margin="0,15" Title="全局设置">
                <StackPanel Margin="25,40,25,15">
                    <Grid x:Name="PanMainLang" Height="28" Margin="0,0,0,10" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="语言" Margin="0,0,25,0" />
                        <local:MyComboBox x:Name="ComboBackgroundSuit" Tag="UiBackgroundSuit" HorizontalAlignment="Left" Width="170" Grid.Column="1">
                            <local:MyComboBoxItem Content="简体中文" Tag="zh_CN" IsSelected="True" />
                            <local:MyComboBoxItem Content="繁體中文" Tag="zh_HK" />
