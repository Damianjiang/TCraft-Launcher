            <local:MyCard x:Name="CardDebug" Margin="0,24,0,0" Title="调试选项" CanSwap="True" IsSwapped="True">
                <StackPanel Margin="32,44,32,24">
                    <Grid x:Name="PanDebugAnim" Height="22" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Text="动画速度" Margin="0,0,25,0" />
                        <local:MySlider x:Name="SliderDebugAnim" local:SettingService.Key="SystemDebugAnim" MaxValue="30" Grid.Column="1" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <local:MyCheckBox Grid.Column="0" Text="禁止在下载时从其他文件夹复制文件" Height="22" x:Name="CheckDebugSkipCopy" local:SettingService.Key="SystemDebugSkipCopy" ToolTip="在下载时不直接复制其他 MC 文件夹中已经存在的相同文件，而是重新下载文件。&#xa;只建议在测试下载速度时开启。" />
                        <local:MyCheckBox Grid.Column="1" Text="调试模式" Height="22" x:Name="CheckDebugMode" local:SettingService.Key="SystemDebugMode" ToolTip="显示调试信息与更多错误信息。&#xa;这会导致启动器性能略有下降，若无特殊需要不建议开启。" />
                        <local:MyCheckBox Grid.Column="2" Text="添加延迟" Height="22" x:Name="CheckDebugDelay" local:SettingService.Key="SystemDebugDelay" ToolTip="在各个环节添加随机的延迟，拖慢加载速度，以测试部分功能是否正常运行。&#xa;这会严重影响启动器运行，若无特殊需要不建议开启。" />
                    </Grid>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,24,0,0" Title="社区">
                <StackPanel Margin="32,44,32,24">
                    <TextBlock TextWrapping="Wrap" LineHeight="24" Opacity="0.7" FontSize="13"
                               Text="想第一时间了解新版本、反馈问题或了解社区动态，可以加入 TCraft NEXT 社群。" />
                    <WrapPanel Margin="0,18,0,0">
                        <local:MyButton Height="35" MinWidth="150" Text="加入 QQ 群" ColorType="Highlight"
                                        Click="BtnJoinQQ_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Margin="0,24,0,0" Title="卸载">
                <StackPanel Margin="32,44,32,24">
                    <TextBlock TextWrapping="Wrap" LineHeight="24" Opacity="0.7" FontSize="13"
                               Text="仅清理启动器自建的内容（配置、日志、缓存、主程序与快捷方式），不会删除 .minecraft 及 Minecraft 数据。确认后程序立即退出，约 3 秒完成清理并自动删除自身。" />
                    <WrapPanel Margin="0,18,0,0">
                        <local:MyButton Height="35" MinWidth="170" Text="卸载 TCraft Launcher" ColorType="Red"
                                        Click="BtnUninstall_Click" />
                    </WrapPanel>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>