                    <TextBlock Grid.Row="12" VerticalAlignment="Center" HorizontalAlignment="Left" Text="渲染器" Margin="0,0,25,0" />
                    <local:MyComboBox local:SettingService.Key="LaunchAdvanceRenderer" Grid.Row="12" Grid.ColumnSpan="2" Grid.Column="1"
                                      ToolTip="通过 mesa-loader 为游戏注入自定义渲染器。&#xa;仅建议在显卡驱动导致游戏崩溃、黑屏等场景下使用，启动器会在需要时自动下载对应文件。">
                        <local:MyComboBoxItem Content="默认（游戏自带渲染器）" />
                        <local:MyComboBoxItem Content="软件渲染（llvmpipe）" ToolTip="使用 CPU 软件渲染，速度较慢但兼容性最好" />
                        <local:MyComboBoxItem Content="DirectX 12（d3d12）" ToolTip="将渲染后端切换为 DirectX 12" />
                        <local:MyComboBoxItem Content="Vulkan（zink）" ToolTip="将渲染后端切换为 Vulkan" />
                    </local:MyComboBox>
                    <TextBlock Grid.Row="14" VerticalAlignment="Center" HorizontalAlignment="Left" Text="IP 栈偏好" Margin="0,0,25,0" />
                    <local:MyComboBox local:SettingService.Key="LaunchPreferredIpStack" Grid.Row="14" Grid.ColumnSpan="2" Grid.Column="1"
                                      ToolTip="向游戏添加 -Djava.net.preferIPv*Stack 参数。&#xa;部分网络环境下使用 IPv4 优先可以解决无法进入服务器的问题。">
                        <local:MyComboBoxItem Content="IPv4 优先" />
                        <local:MyComboBoxItem Content="Java 默认" IsSelected="True" />
                        <local:MyComboBoxItem Content="IPv6 优先" />
                    </local:MyComboBox>
                    <TextBlock Grid.Row="16" VerticalAlignment="Center" HorizontalAlignment="Left" Text="类路径头部" Margin="0,0,25,0" />
                    <local:MyTextBox local:SettingService.Key="LaunchAdvanceClasspathHead" Grid.Row="16" Grid.ColumnSpan="2" Grid.Column="1"
                                     HintText="留空则不添加"
                                     ToolTip="以分号分隔的 jar 或目录列表，将被插入到 classpath 的最前面。&#xa;用于特殊 Mod 或工具链，一般用户请勿填写。" />
                    <StackPanel Margin="0,18,0,8" Grid.Row="18" Grid.ColumnSpan="2" HorizontalAlignment="Left">
                        <local:MyCheckBox Height="30" Text="锁定内存分配（-Xms = -Xmx）" local:SettingService.Key="LaunchAdvanceLockMemory"
                                          ToolTip="开启后，初始内存（-Xms）将与最大内存（-Xmx）保持一致，降低延迟抖动，利于 ZGC。&#xa;开启后 内存分配 卡片中的滑块将失效。" />
                        <local:MyCheckBox Height="30" Text="跳过崩溃分析" local:SettingService.Key="LaunchAdvanceDisableCrashAnalysis"
                                          ToolTip="游戏崩溃时不再自动收集日志并分析，加快崩溃处理速度" />
                        <local:MyCheckBox Height="30" Text="显示控制台窗口（java.exe）" local:SettingService.Key="LaunchAdvanceNoJavaw"
                                          ToolTip="启动游戏时不隐藏控制台窗口，便于查看日志与排查问题。" />
                        <local:MyCheckBox Height="30" Text="禁用 LegacyFix" local:SettingService.Key="LaunchAdvanceDisableLF"
                                          ToolTip="LegacyFix 用于修复 2013 年 6 月 25 日以前的远古版本（Beta / 早期 Release）的兼容性问题，一般请勿禁用。" />
                    </StackPanel>
                    <local:MyHint Text="版本独立设置中还有更多高级选项可供调整。" Margin="0,14,0,10" Theme="Blue" Grid.Row="20" Grid.ColumnSpan="2"
                                  CanClose="True" RelativeSetup="HintMoreAdvancedSetup" />
                </Grid>
