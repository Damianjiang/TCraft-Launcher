<local:MyPageLeft
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TCraft" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="PageSetupLeft"
             d:DesignWidth="172" AnimatedControl="PanItem">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- 侧边栏仍为 TCL 风格；Win11 的分组感通过「组间距 + 分隔线」体现，不改动 PanItem 的子项顺序与命名 -->
        <StackPanel Grid.Row="0" Margin="14,16,10,6">
            <TextBlock Text="设置" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
            <!-- 设置搜索。输入即过滤下方导航列表为结果列表，清空即恢复。 -->
            <local:MyTextBox x:Name="TxtSearch" Height="30" Margin="0,10,2,0" HintText="搜索设置" MaxLength="200"
                             ToolTip="搜索所有设置项，点击结果即可跳转并高亮" />
        </StackPanel>
        <!-- 侧边栏改用全局 TCL 滚动条 MyScrollViewer（ScrollViewerFullMargin），绝不用 .NET 默认滚动条；
             选项不足高度时可竖向滚动，防止「清理缓存」被窗口底边裁掉点不到。 -->
        <local:MyScrollViewer Grid.Row="1" PanningMode="VerticalOnly" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Style="{StaticResource ScrollViewerFullMargin}">
            <StackPanel>
            <StackPanel x:Name="PanItem">
            <local:MyListItem x:Name="ItemLaunch" IsScaleAnimationEnabled="False" Tag="0" MinPaddingRight="35" Height="34" VerticalAlignment="Top" Title="启动" Type="RadioBox"
                LogoScale="0.8" SvgIcon="lucide/play" Margin="0,0,0,3">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="0" ToolTip="初始化本页设置" ToolTipService.InitialShowDelay="200" Click="Reset" SvgIcon="lucide/rotate-ccw" LogoScale="0.9" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <local:MyListItem x:Name="ItemLink" IsScaleAnimationEnabled="False" Tag="1" MinPaddingRight="35" Height="34" VerticalAlignment="Top" Title="联机" Type="RadioBox"
                LogoScale="0.9" SvgIcon="lucide/globe" Margin="0,0,0,3">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="1" ToolTip="初始化本页设置" ToolTipService.InitialShowDelay="200" Click="Reset" SvgIcon="lucide/rotate-ccw" LogoScale="0.9" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <local:MyListItem x:Name="ItemUI" IsScaleAnimationEnabled="False" Tag="2" MinPaddingRight="35" Height="34" VerticalAlignment="Top" Title="个性化" Type="RadioBox"
                LogoScale="0.9" SvgIcon="lucide/palette" Margin="0,0,0,3">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="2" ToolTip="初始化本页设置" ToolTipService.InitialShowDelay="200" Click="Reset" SvgIcon="lucide/rotate-ccw" LogoScale="0.9" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <local:MyListItem x:Name="ItemSystem" IsScaleAnimationEnabled="False" Tag="3" MinPaddingRight="35" Height="34" VerticalAlignment="Top" Title="系统" Type="RadioBox"
                LogoScale="0.9" SvgIcon="lucide/cpu" Margin="0,22,0,3">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="3" ToolTip="初始化本页设置" ToolTipService.InitialShowDelay="200" Click="Reset" SvgIcon="lucide/rotate-ccw" LogoScale="0.9" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <local:MyListItem x:Name="ItemJava" IsScaleAnimationEnabled="False" Tag="4" MinPaddingRight="35" Height="34" VerticalAlignment="Top" Title="Java" Type="RadioBox"
                LogoScale="0.9" SvgIcon="lucide/coffee" Margin="0,0,0,3">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="4" ToolTip="初始化本页设置" ToolTipService.InitialShowDelay="200" Click="Reset" SvgIcon="lucide/rotate-ccw" LogoScale="0.9" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <local:MyListItem x:Name="ItemLog" IsScaleAnimationEnabled="False" Tag="5" MinPaddingRight="35" Height="34" VerticalAlignment="Top" Title="日志" Type="RadioBox"
                LogoScale="0.9" SvgIcon="lucide/scroll-text" Margin="0,0,0,3">
                <local:MyListItem.Buttons>
                    <x:Array Type="{x:Type local:MyIconButton}">
                        <local:MyIconButton Tag="5" ToolTip="初始化本页设置" ToolTipService.InitialShowDelay="200" Click="Reset" SvgIcon="lucide/rotate-ccw" LogoScale="0.9" />
                    </x:Array>
                </local:MyListItem.Buttons>
            </local:MyListItem>
            <!-- 「清理缓存」是普通选项页，放在「返回」上方；「返回」固定作为侧边栏最后一项（footer）。
                 高亮不再依赖 Children 的物理索引，改由 FormMain 按 Tag 匹配（见 FormMain PageChange）。
                 图标用 lucide/trash-2（内嵌包已有；trash.svg 未打进内嵌包，故弃用）。 -->
            <local:MyListItem x:Name="ItemCache" IsScaleAnimationEnabled="False" Tag="7" MinPaddingRight="35" Height="34" VerticalAlignment="Top" Title="存储与清理" Type="RadioBox"
                LogoScale="0.9" SvgIcon="lucide/trash-2" Margin="0,12,0,0" />
            <!-- 网络设置（代理 / 下载源测速） -->
            <local:MyListItem x:Name="ItemNetwork" IsScaleAnimationEnabled="False" Tag="8" MinPaddingRight="35" Height="34" VerticalAlignment="Top" Title="网络" Type="RadioBox"
                LogoScale="0.9" SvgIcon="lucide/network" Margin="0,3,0,0" />
            <!-- 补上「更多」页入口。该页（社区加群 / 卸载启动器）一直有实现，
                 却只出现在设置搜索里，侧边栏没有入口——用户找不到「卸载」就是这个原因。 -->
            <local:MyListItem x:Name="ItemMore" IsScaleAnimationEnabled="False" Tag="6" MinPaddingRight="35" Height="34" VerticalAlignment="Top" Title="更多" Type="RadioBox"
                LogoScale="0.9" SvgIcon="lucide/tool-case" Margin="0,3,0,0" />
            <local:MyListItem x:Name="ItemBack" IsScaleAnimationEnabled="False" Type="Clickable" MinPaddingRight="35" Height="34" VerticalAlignment="Top" Title="返回" SvgIcon="lucide/arrow-left" Margin="0,12,0,0" />
            </StackPanel>
            <!-- 搜索结果列表：行由代码动态生成（标题 + 所在页名 + 页图标），与导航列表二选一显示 -->
            <StackPanel x:Name="PanSearchResult" Visibility="Collapsed" Margin="0,4,0,12">
                <TextBlock x:Name="LabSearchEmpty" Text="没有找到相关设置" FontSize="12" Opacity="0.55" Margin="14,10,10,4" Visibility="Collapsed" Foreground="{DynamicResource ColorBrush1}" />
            </StackPanel>
        </StackPanel>
        </local:MyScrollViewer>
    </Grid>
</local:MyPageLeft>
