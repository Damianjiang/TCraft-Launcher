<local:MyPageRight x:Class="PageSetupCache"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:TCraft"
                   mc:Ignorable="d"
                   d:DesignHeight="450" d:DesignWidth="800"
                   PanScroll="{Binding ElementName=PanBack}" RenderOptions.BitmapScalingMode="LowQuality">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <DockPanel>
            <!-- Win11 风格页头 -->
            <StackPanel DockPanel.Dock="Top" Margin="40,20,36,2">
                <TextBlock Text="存储与清理" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
                <TextBlock Text="看清启动器与游戏各自的磁盘占用，安全释放空间。" FontSize="13" Opacity="0.55" Margin="0,6,0,0" Foreground="{DynamicResource ColorBrush1}" />
            </StackPanel>

            <!-- 存储总览（对齐 LumilioCL 的「下载与存储 · 存储占用」条形图） -->
            <local:MyCard DockPanel.Dock="Top" Title="存储总览" Margin="32,24,32,0">
                <StackPanel Margin="32,44,32,22">
                    <StackPanel x:Name="PanStorage" />
                    <TextBlock x:Name="LabStorageNote" Text="后台计算中…" FontSize="12" Opacity="0.55"
                               TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
            </local:MyCard>

            <!-- 占用统计 + 分类勾选 -->
            <local:MyCard DockPanel.Dock="Top" Title="缓存占用" Margin="32,24,32,0">
                <StackPanel Margin="32,44,32,22">
                    <StackPanel x:Name="PanTotal" Margin="0,0,0,16" />
                    <StackPanel x:Name="PanList" />
                </StackPanel>
            </local:MyCard>

            <!-- 操作 -->
            <local:MyCard DockPanel.Dock="Top" Title="操作" Margin="32,24,32,28">
                <StackPanel Margin="32,44,32,26">
                    <TextBlock x:Name="LabNote"
                               Text="只清理可重新生成或重新下载的内容；不会删除你的配置、背景与音乐、皮肤、翻译文件或游戏数据。"
                               TextWrapping="Wrap" LineHeight="22" Opacity="0.65" FontSize="13" Margin="0,0,0,18" />
                    <Grid Height="40" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton MinWidth="140" Text="清理所选缓存" ColorType="Red" Margin="0,0,20,0"
                                        Click="BtnClean_Click" />
                        <local:MyButton MinWidth="140" Text="检查无用文件" ColorType="Normal" Margin="0,0,20,0"
                                        Click="BtnScanJunk_Click" Grid.Column="1"/>
                        <local:MyButton MinWidth="140" Text="刷新" ColorType="Normal" Margin="0,0,20,0"
                                        Click="BtnRefresh_Click" Grid.Column="2"/>
                        <local:MyButton MinWidth="140" Text="打开缓存目录" ColorType="Normal"
                                        Click="BtnOpen_Click" Grid.Column="3"/>
                    </Grid>
                </StackPanel>
            </local:MyCard>
        </DockPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
