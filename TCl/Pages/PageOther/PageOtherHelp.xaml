<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCraft"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageOtherHelp"
    PanScroll="PanBack" RenderOptions.BitmapScalingMode="LowQuality">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">

            <local:MyCard Margin="0,15,0,15" Title="首次使用（开箱三步）">
                <TextBlock Margin="25,42,23,20" TextWrapping="Wrap" LineHeight="22"
                    Text="第一次打开 TCL，按顺序做三件事即可进入游戏：&#10;1. 确认 Java：多数版本自带匹配，若启动报 Java 相关错误，到「设置 → Java」手动指定一个 Java 路径（老版本用 Java 8，新版本用 17 或更高）。&#10;2. 下载版本：进「下载」页选一个 Minecraft 版本并安装（见下一节）。&#10;3. 登录并启动：切到「启动」页，选登录方式、点「开始游戏」。&#10;首次启动会弹窗介绍 TCL，看完点「我知道了」即可，之后不再出现。" />
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="下载并安装 Minecraft（详细）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock TextWrapping="Wrap" LineHeight="20"
                        Text="1. 打开「下载」页，左侧选择版本类型：原版（vanilla）、Forge、NeoForge、Fabric、OptiFine、LiteLoader。&#10;2. 右侧会出现该类型下的具体版本号，选中你要玩的那一个。&#10;3. 点「下载并开始安装」。进度条会实时显示下载百分比，全程走多线程并对节点测速，自动挑最快的一条。&#10;4. 下载完成后会自动安装，装好即可在「启动」页看到该版本。&#10;小提示：想玩别人的整合包，进「下载 → 整合包」，粘贴整合包地址或上传本地整合包文件，同样点「下载并开始安装」。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="登录与启动游戏（详细）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock Text="登录" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="进「启动」页，选择你的账号类型：正版账号（国际区直接登录；国内区账号用「国内区」方式）、或离线模式（无需账号，自己填一个名字即可，只能打单人/自己开的联机，不能上别人家的正版服）。" />
                    <TextBlock Text="启动" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="1. 在实例列表点选你要玩的版本。&#10;2. 按需调内存：在启动页或「设置 → 启动」里设置 -Xmx（分配给游戏的最大内存）。一般 8G 内存机器设 4096 比较稳。&#10;3. 点「开始游戏」。游戏会从独立窗口启动，TCL 仍保留在后台。" />
                    <TextBlock Text="启动失败" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" LineHeight="20"
                        Text="启动不了时，TCL 会自动做崩溃分析并记录日志。到「设置 → 日志」查看/导出日志，看是哪个 Mod 或 Java 版本不匹配，针对性处理。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="加 Mod / 资源包 / 光影（详细）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock TextWrapping="Wrap" LineHeight="20"
                        Text="针对某个版本加内容，走两条路任选：&#10;· 在「下载 → 模组 / 资源包 / 光影」里搜名字，勾选后点「下载并开始安装」，装到你选定的版本实例里。&#10;· 已有本地文件：在「下载」页用「导入本地文件」把 jar / zip 拖进来，同样选目标版本安装。&#10;装好后回到「启动」页选这个版本，点「开始游戏」即可生效。要管理某个实例的 Mod、看 Jar-in-Jar 内嵌依赖，进顶部「实例」页选对应实例，再点左侧「Mod 管理」操作。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="和朋友联机（详细）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock Text="开房间（当房主）" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="进「联机」页点「创建房间」，基于 EasyTier 的 P2P 联机，不需要你有公网 IP。创建后会把邀请信息发给你，把邀请码发给朋友。你也可以勾选把某个单人存档分享给房间，让朋友直接进你的世界。" />
                    <TextBlock Text="进房间（当玩家）" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" LineHeight="20"
                        Text="收到朋友的邀请码后，进「联机」页点「加入房间」，粘贴邀请码，选你要加入的房即可。在线状态与服务器列表也都在这一页。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="设置说明 · 启动选项（设置 → 启动）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock Text="默认版本隔离" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="控制不同版本的存档 / Mod / 资源包是否互通。关闭＝全部共用同一档案（多个装了 Mod 的版本可能互相冲突）；隔离可装 Mod 的版本＝Mod 版独立、原版共用（最常用）；隔离所有版本＝完全独立（连原版存档都不能共用，一般不推荐）。它只影响之后新装的版本，已装版本请到顶部「实例」页 → 选中该实例 → 左侧「设置」里单独调整。" />
                    <TextBlock Text="游戏窗口标题 / 自定义信息" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="自定义标题改游戏窗口标题栏文字，留空则不改；「自定义信息」显示在游戏主界面左下角和 F3 调试页左上角（注意：Mojang 在 Minecraft 26.1 已移除该显示，新版里无效）。两者都能用「替换标记」动态填内容，用法见下方「替换标记」一节。" />
                    <TextBlock Text="启动器可见性 / 进程优先级 / 窗口大小" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" LineHeight="20"
                        Text="可见性＝游戏启动后启动器是关闭 / 隐藏 / 最小化 / 保持不变；优先级＝游戏进程的 CPU 权重（中 平衡最稳，极高 / 实时会让整机卡顿，仅测试用）；窗口大小＝全屏 / 默认 / 与启动器一致 / 自定义 / 最大化（个别 Forge 版本有 Bug 会让高度设定无效）。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="设置说明 · 内存分配（设置 → 启动）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock Text="自动配置 / 自定义" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="自动＝按你装的 Mod 量和电脑剩余内存动态分配；自定义＝手动拖滑块设最大内存 -Xmx（8G 内存的机器设 4096 较稳）。滑块下方是初始内存 -Xms：越小启动越快、系统留用越多，越大加载越流畅。" />
                    <TextBlock Text="锁定内存分配（-Xms = -Xmx）" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="让初始内存等于最大内存，降低延迟抖动、利于 ZGC；开启后滑块会失效。" />
                    <TextBlock Text="启动游戏前进行内存优化" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="启动前把当前物理内存占用清掉约 1/3（对整机有效，不只 MC）；机械硬盘上可能有一小段明显卡顿。用「--memory」参数启动 TCL 可静默执行。" />
                    <TextBlock Text="内存管理（GC）" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" LineHeight="20"
                        Text="ZGC / 分代 ZGC 内存占用更高但回收时不卡顿；G1GC 占用更低但回收时有突刺。Java 21+ 自动用分代 ZGC，14- 用 G1GC。选「不指定」时才能自己在「Java 虚拟机参数」里手动加 GC 参数。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="设置说明 · 下载与网络（设置 → 系统）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock Text="下载源 / 线程 / 限速" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="文件与版本列表源可选「尽量镜像 / 官方优先慢时换镜像 / 尽量官方」。最大线程数一般 64 就够（过高反而卡顿）；速度限制设下载上限，避免下资源时把别的联网程序卡死；目标文件夹就是 Minecraft 的存放位置。" />
                    <TextBlock Text="HTTP 代理" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="可「不经过代理 / 跟随系统（Clash、v2rayN 等）/ 自定义」。自定义时填 127.0.0.1:1080 这种格式；勾选「启动游戏时使用此代理」可让游戏内访问 Mojang、下资源也走代理。" />
                    <TextBlock Text="缓存文件夹 / 硬件加速" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" LineHeight="20"
                        Text="缓存＝TCL 下载、皮肤的存储位置（路径别带空格，留空即默认，改后重启生效）。界面卡顿、花屏或显卡驱动异常时，可开「禁用硬件加速（软件渲染）」。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="设置说明 · 外观与个性化（设置 → 个性化）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock Text="组件半透明 / 最大帧率" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="半透明 0（全透）～100（全实），透出背景形成磨砂玻璃；配「背景模糊」更好（模糊会掉帧、做整合包时别开）。限制最大帧率能降 CPU / GPU 占用。" />
                    <TextBlock Text="背景图片 / 音乐 / 视频" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="把图片、音乐、视频（mp4/wmv/mov/mkv/avi/webm）分别放进对应文件夹，TCL 会随机或循环加载；视频配「组件半透明」能出动态磨砂背景。" />
                    <TextBlock Text="主题 / 邮箱隐藏 / 功能隐藏" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" LineHeight="20"
                        Text="换配色主题（部分需解锁）；「邮箱隐藏」把第三方登录的邮箱打码防隐私泄露（重启生效）；「功能隐藏」可隐藏不想让别人动的页面/入口，隐藏后下次启动自动恢复。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="设置说明 · 联机节点（设置 → 联机）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock Text="模式 / 节点" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="模式「优先直连」尽量 P2P 不中转，「优先低延迟」在中转更快时走中转。节点选「自动」按内置顺序逐个试最稳；自建 EasyTier 节点就填「自定义」，逗号分隔多个（房主和加入者必须连上至少同一个节点才连得上）。" />
                    <TextBlock Text="下载方式" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" LineHeight="20"
                        Text="下载联机核心 EasyTier 时用哪个节点。「自动」首次并行测速记住最快的沿用；「指定」手动选（含 GitHub 加速镜像榜）。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="设置说明 · Java 与日志（设置 → Java / 日志）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock Text="Java 列表" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="启动时 TCL 自动选列表里第一个兼容当前版本的 Java；点右侧箭头可排序控制优先级。要强制无视兼容性用某个 Java，请到顶部「实例」页 → 选中该实例 → 左侧「设置」里改。" />
                    <TextBlock Text="控制台 / 崩溃分析" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="20"
                        Text="「显示控制台」开机不隐藏 java.exe 窗口方便看日志；「跳过崩溃分析」崩了不再自动收日志（更快但少了分析）。" />
                    <TextBlock Text="日志" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap" LineHeight="20"
                        Text="「设置 → 日志」可查看全部日志、导出或打开日志文件夹。游戏出问题就带这里的日志找原因，别只发截图。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="替换标记（工具）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock TextWrapping="Wrap" LineHeight="20"
                        Text="多处设置（游戏窗口标题、自定义信息、Java 虚拟机参数、游戏参数、启动前命令）都支持「替换标记」——在文本里写 {标记} 就能自动填进对应值，例如：&#10;· {verpath}：当前版本文件夹路径&#10;· {java}：所用 java.exe 路径&#10;· {verindie}：版本内部路径&#10;&#10;例子：启动前命令里写 &#10;· notepad {verindie}options.txt　＝用记事本打开该版本的设置文件&#10;· {java} -jar {verpath}test.jar　＝用 Java 跑版本文件夹里的 test.jar&#10;涉及路径都建议加双引号，避免路径里的空格导致失败。命令行工作目录是当前的 .minecraft 文件夹。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="常见问题（可直接照做）">
                <StackPanel Margin="25,42,23,20">
                    <TextBlock Text="· 下载失败 / 一直转圈？" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,14" TextWrapping="Wrap"
                        Text="先确认能正常上网；再到「设置 → 联机」换一个下载镜像（国内/国际）；如果开过代理，先关掉代理再重试下载。" />
                    <TextBlock Text="· 游戏一启动就闪退？" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,14" TextWrapping="Wrap"
                        Text="多半是 Java 版本不匹配：老版本（1.12 以前）用 Java 8，新版本（1.18 以后）用 17 及以上。到「设置 → Java」手动指定正确路径。仍闪退就导出日志看是哪个 Mod 崩的。" />
                    <TextBlock Text="· 找不到我的整合包 / 实例？" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,14" TextWrapping="Wrap"
                        Text="到「设置 → 下载」核对 Minecraft 安装位置是否指对了文件夹；指错就在这里重新选择。" />
                    <TextBlock Text="· 正版账号登录不上？" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,14" TextWrapping="Wrap"
                        Text="确认网络通畅，且是国际区账号；国内区账号请改用登录页里的「国内区」方式，别用国际区入口。" />
                    <TextBlock Text="· 怎么把整合包分享给朋友？" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Margin="0,0,0,0" TextWrapping="Wrap"
                        Text="进顶部「实例」页选该实例，点左侧「导出」，把生成的文件发给对方，对方在「下载 → 整合包」里导入即可一键还原全套。" />
                </StackPanel>
            </local:MyCard>

            <local:MyCard Margin="0,0,0,15" Title="获取帮助">
                <TextBlock Margin="25,42,23,20" TextWrapping="Wrap" LineHeight="22"
                    Text="上面这些都没解决的话，可以进 TCL 官方 TCraft Launcher 启动器交流群求助：&#10;&#10;  群号：1131373915&#10;  点击加入：https://qm.qq.com/q/WaG64YE9uo&#10;&#10;入群后请说明你的系统（Windows 版本、Java 版本、Minecraft 版本）以及具体遇到了什么问题，越详细越快定位。游戏出问题时记得带上「设置 → 日志」导出的日志，不要只发截图。" />
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
