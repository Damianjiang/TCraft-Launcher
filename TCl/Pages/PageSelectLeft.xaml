<local:MyPageLeft
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TCraft;assembly=" x:Class="PageSelectLeft"
             AnimatedControl="PanList">
    <AdornerDecorator>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition Height="5" />
            </Grid.RowDefinitions>
            <local:MyScrollViewer DeltaMult="0.7" Grid.Row="1" MaxWidth="300" MinWidth="250" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ScrollViewerFullMargin}">
                <StackPanel x:Name="PanList" />
            </local:MyScrollViewer>
            <!-- 文件夹操作菜单改为动画卡片（与首页「更多」/实例页同款三段动画），替代裸 ContextMenu -->
            <!-- 定位改由 MenuCard.ApplyAnchor 按「锚点 + 对齐方向」计算，不再裸用 Placement=Bottom -->
            <Popup x:Name="PopupFolderMenu" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None" Placement="Custom">
            <Border x:Name="CardFolderMenu" Background="{DynamicResource ColorBrushCardBg}" CornerRadius="10" Padding="8" Margin="14"
                    Opacity="0" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="TransformFolderMenuScale" ScaleX="0.94" ScaleY="0.94" />
                        <TranslateTransform x:Name="TransformFolderMenuPos" X="0" Y="10" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="18" ShadowDepth="3" Opacity="0.35" RenderingBias="Performance" />
                </Border.Effect>
                <local:MyScrollViewer x:Name="ScrollFolderMenu" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanFolderMenu" MinWidth="170" />
                </local:MyScrollViewer>
            </Border>
        </Popup>
        </Grid>
    </AdornerDecorator>
</local:MyPageLeft>
