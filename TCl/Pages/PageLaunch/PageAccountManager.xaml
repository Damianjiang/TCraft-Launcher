<local:MyPageRight x:Class="PageAccountManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TCraft"
             mc:Ignorable="d" PanScroll="PanBack" RenderOptions.BitmapScalingMode="LowQuality">
    <!--第 71 轮：移除内嵌登录页宿主（CardForm/PanFormHost/BtnFormBack）——
        添加微软账号改为直接弹出登录弹窗开始登录，不再有中间页面。-->
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10,25,10">
            <!--第 72 轮：侧边栏已删，「添加账户」入口移入本页（HMCL 式）-->
            <local:MyIconTextButton x:Name="BtnAddAccount" Text="添加账户" SvgIcon="lucide/user-plus" LogoScale="0.95"
                                    Height="28" HorizontalAlignment="Left" Margin="0,15,0,0" />
            <local:MyCard Margin="0,10,0,15" Title="账户列表" x:Name="CardAccounts">
                <StackPanel Margin="20,36,20,20" x:Name="PanAccounts" />
            </local:MyCard>
            <!-- 第 133 轮：正版皮肤与披风（原先由 PageLoginMsSkin 提供，但该页从未被实例化，
                 「修改皮肤 / 更换披风 / 保存皮肤 / 兑换」这些功能一直没有入口，这里补上） -->
            <local:MyCard Margin="0,0,0,15" Title="正版皮肤与披风" x:Name="CardSkin" Visibility="Collapsed">
                <Grid Margin="22,40,22,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="112" Height="112" Margin="0,0,20,0" VerticalAlignment="Top"
                            CornerRadius="6" Background="{DynamicResource ColorBrushSemiTransparent}">
                        <local:MySkin x:Name="SkinPreview" HasCape="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <local:MySkin.LayoutTransform>
                                <ScaleTransform ScaleX="1.55" ScaleY="1.55" />
                            </local:MySkin.LayoutTransform>
                        </local:MySkin>
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="LabSkinHint" Text="这里是当前正版账户的皮肤预览。修改后会自动刷新头像与标题栏徽章。"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" LineHeight="19"
                                   Foreground="{DynamicResource ColorBrush1}" />
                        <WrapPanel Margin="0,12,0,0">
                            <local:MyButton x:Name="BtnSkinChange" MinWidth="110" Height="32" Text="修改皮肤" ColorType="Highlight" Margin="0,0,12,10" />
                            <local:MyButton x:Name="BtnCapeChange" MinWidth="110" Height="32" Text="更换披风" Margin="0,0,12,10" />
                            <local:MyButton x:Name="BtnSkinSaveFile" MinWidth="110" Height="32" Text="保存皮肤文件" Margin="0,0,12,10" />
                            <local:MyButton x:Name="BtnSkinRefreshNow" MinWidth="110" Height="32" Text="刷新皮肤" Margin="0,0,12,10" />
                            <local:MyButton x:Name="BtnRedeem" MinWidth="110" Height="32" Text="兑换 CDKEY" Margin="0,0,12,10" />
                            <local:MyButton x:Name="BtnProfileWeb" MinWidth="110" Height="32" Text="官网管理" Margin="0,0,0,10" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
