<local:MyPageRight x:Class="PageLaunchRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:behaviors="clr-namespace:TCraft.Controls.Behaviors"
    xmlns:local="clr-namespace:TCraft" PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel Name="PanMain" Margin="25,25,25,150" Grid.IsSharedSizeScope="True">
                <local:MyHint x:Name="PanHint" RelativeSetup="HintSnapshot" Theme="Blue" CanClose="True" Margin="0,0,0,15"
                              Text="快照版 TCL 包含尚未正式发布的测试功能，请谨慎使用。&#xa;请不要随意发给其他人，或是用来制作整合包哦！" />
                <local:MyCard Margin="0,0,0,15" Title="启动日志" x:Name="PanLog">
                    <local:MyTextBox x:Name="LabLog" Margin="15,34,15,13" Padding="0,4" IsReadOnly="True" IsUndoEnabled="False"
                             AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" HasBackground="False"
                             VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" />
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
        <!--右下角：问候语 + 启动按钮-->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,25" Width="330" x:Name="PanLaunchButtons">
            <!--问候语-->
            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                <TextBlock x:Name="LabGreeting" Text="" FontSize="19" FontWeight="SemiBold" Foreground="#FFFFFFFF"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" SnapsToDevicePixels="False">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF000000" BlurRadius="4" ShadowDepth="1" Opacity="0.65" RenderingBias="Performance" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="LabGreetingSub" Text="" FontSize="12" Foreground="#F2FFFFFF" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" SnapsToDevicePixels="False">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FF000000" BlurRadius="3" ShadowDepth="1" Opacity="0.6" RenderingBias="Performance" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
            <!--启动按钮 + 连体下拉（实例管理 / 版本设置）-->
            <Grid RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="AprilScaleTrans" />
                        <TranslateTransform x:Name="AprilPosTrans" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <local:MyButton x:Name="BtnLaunch" Height="54" Text="正在加载" ColorType="Theme" Padding="30,0,30,15" IsEnabled="False" />
                    <!--版本名要跟按钮文字对齐：必须放进第 0 列，只按启动按钮自身的宽度居中。
                        放在外层 Grid 里会把右侧 48px 下拉段 + 6px 间隙一起算进居中宽度，
                        结果整体右偏约 27px（用户反馈「版本偏位置了，要中间」）。-->
                    <TextBlock x:Name="LabVersion" Grid.Column="0" Text="正在加载版本列表，请稍候" Margin="15,0,15,10" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#F2FFFFFF" RenderTransformOrigin="0.5,-0.2">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="{Binding RealRenderTransform.ScaleX, ElementName=BtnLaunch, Mode=OneWay}" ScaleY="{Binding RealRenderTransform.ScaleY, ElementName=BtnLaunch, Mode=OneWay}" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <Border x:Name="BtnLaunchMenu" Grid.Column="2" Width="48" Height="54" Background="{DynamicResource ColorBrush2}" CornerRadius="10"
                            Cursor="Hand" ToolTip="实例管理与版本设置">
                        <local:MyIconButton x:Name="LabLaunchMenuIcon" SvgIcon="lucide/chevron-down" Theme="White"
                                            Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                            <local:MyIconButton.RenderTransform>
                                <RotateTransform Angle="0" />
                            </local:MyIconButton.RenderTransform>
                        </local:MyIconButton>
                    </Border>
                </Grid>
            </Grid>
        </StackPanel>
        <!--启动按钮的展开菜单：原来的 ContextMenu 换成图标+文字的大卡片，
            带「缩放+上浮」展开动画；StaysOpen=False 负责点外面收起。-->
        <Popup x:Name="PopupLaunchMenu" PlacementTarget="{Binding ElementName=BtnLaunchMenu}" Placement="Top"
               VerticalOffset="-6" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None">
            <Border x:Name="CardLaunchMenu" Background="{DynamicResource ColorBrushCardBg}" CornerRadius="10" Padding="8" Margin="14"
                    Opacity="0" RenderTransformOrigin="0.5,1">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="TransformLaunchMenuScale" ScaleX="0.94" ScaleY="0.94" />
                        <TranslateTransform x:Name="TransformLaunchMenuPos" X="0" Y="10" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="18" ShadowDepth="3" Opacity="0.35" RenderingBias="Performance" />
                </Border.Effect>
                <StackPanel MinWidth="204">
                    <local:MyListItem x:Name="ItemMenuSelect" Title="版本选择" SvgIcon="lucide/layers" Type="Clickable"
                                      Height="42" IsScaleAnimationEnabled="False" VerticalAlignment="Top" />
                    <local:MyListItem x:Name="ItemMenuSetup" Title="版本设置" SvgIcon="lucide/settings" Type="Clickable"
                                      Height="42" IsScaleAnimationEnabled="False" VerticalAlignment="Top" Margin="0,2,0,0" />
                </StackPanel>
            </Border>
        </Popup>
        <!--启动侧边栏：改成从窗口最左边向右展开的侧边栏，展开后显示启动动画，
            启动成功（或失败、取消）再收回去。为了能盖住左边栏、真正做到"从最左边展开"，
            Init 里会把这个 PanLaunching 从本页移交给 FormMain.HostLaunchSide（窗口层）。
            内部控件名保持不变（LabLaunching* / ProgressLaunching* / PanLaunchingInfo…），
            PageLaunchRight 的刷新逻辑不用改。-->
        <Grid Name="PanLaunching" Visibility="Collapsed">
            <!--右侧内容压暗；侧边栏在它上面，不受影响-->
            <Rectangle x:Name="RectLaunchingMask" Fill="#40000000" Opacity="0" />
            <!--侧边栏本体：宽度从 0 拉到 364，靠内层 Grid 的 ClipToBounds 裁出"从左边擦出来"的效果。
                注意 ClipToBounds 不能放在这个 Border 上——它会连 Border 自己的投影一起裁掉，
                右边缘的阴影就没了；所以裁切交给里面那层 PanLaunchSideClip。-->
            <Border Name="PanLaunchingCard" HorizontalAlignment="Left" Width="0"
                    Background="#FBFBFB" BorderBrush="{DynamicResource ColorBrushGray3}" BorderThickness="0,0,1,0">
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="26" ShadowDepth="6" Direction="0" Opacity="0.45" RenderingBias="Performance" />
                </Border.Effect>
                <Grid x:Name="PanLaunchSideClip" ClipToBounds="True" HorizontalAlignment="Left">
                    <!--固定宽度 312：展开过程中内容不重新排版，只是被右边裁掉，视觉上就是一次横向擦除-->
                    <Grid Width="312" Margin="26,26,26,24" Opacity="0" Name="PanLaunchSideInner">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Name="LabLaunchingTitle" Text="正在启动游戏" FontSize="23" TextTrimming="None"
                               Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Left" VerticalAlignment="Top"
                               SnapsToDevicePixels="False" UseLayoutRounding="False" />
                    <Rectangle Grid.Row="1" Name="ShapeLineLaunching" Height="2" Fill="{Binding Foreground, ElementName=LabLaunchingTitle}" />
                    <!--启动动画-->
                    <StackPanel Grid.Row="3" VerticalAlignment="Top">
                        <local:MyLoading x:Name="LoadLaunching" AutoRun="False" Height="76" Margin="0,6,0,2" HorizontalAlignment="Center"
                                         Background="Transparent" Text="" />
                        <TextBlock Name="LabLaunchingName" Margin="0,4,0,0" FontSize="13" Text="Forge 1.12.2-15.8.0.1560" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ColorBrushGray2}" />
                        <Grid Height="4" Margin="0,16,0,14" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Name="ProgressLaunchingFinished" Width="69.28*"/>
                                <ColumnDefinition Name="ProgressLaunchingUnfinished" Width="30.72*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" >
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="1,0" StartPoint="0,0">
                                        <GradientStop Color="{DynamicResource ColorObject4}" Offset="0"/>
                                        <GradientStop Color="{DynamicResource ColorObject3}" Offset="0.6"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <!--底槽用中性灰：半透明浅蓝在白底上几乎看不见-->
                            <Rectangle Grid.Column="1" Fill="{DynamicResource ColorBrushGray3}" Opacity="0.25" />
                        </Grid>
                        <Grid HorizontalAlignment="Center" Name="PanLaunchingInfo">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="当前步骤" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" Opacity="0.5" Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="下载支持" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingStage" Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="登录方式" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Opacity="0.5" Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="正版登录" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingMethod" Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="启动进度" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Opacity="0.5" Name="LabLaunchingProgressLeft" Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="69.28 %" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingProgress" Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="下载速度" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Opacity="0" Name="LabLaunchingDownloadLeft" Visibility="Collapsed" Foreground="{DynamicResource ColorBrush1}" />
                            <TextBlock FontSize="12.5" Margin="0,0,0,5" Text="5.2 M/s" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" Name="LabLaunchingDownload" Opacity="0" Visibility="Collapsed" Foreground="{DynamicResource ColorBrush1}" />
                            <Grid x:Name="PanLaunchingHint" HorizontalAlignment="Center" Grid.Row="2" Grid.ColumnSpan="5" Grid.RowSpan="2" Width="300" Margin="0,14,0,2" Visibility="Collapsed" Opacity="0">
                                <Border Margin="0,8,0,0" BorderThickness="1" CornerRadius="3" BorderBrush="{StaticResource ColorBrushGray1}" Opacity="0.5">
                                    <Border.Clip>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <RectangleGeometry Rect="0,0,1000,1000" />
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <RectangleGeometry Rect="122,0,56,10" />
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Border.Clip>
                                </Border>
                                <TextBlock FontSize="12.5" Text="你知道吗" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="{StaticResource ColorBrushGray1}" Opacity="0.5" />
                                <TextBlock x:Name="LabLaunchingHint" FontSize="12.5" Text="" Margin="11,21,11,10" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{DynamicResource ColorBrush1}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                    <local:MyButton x:Name="BtnCancel" Grid.Row="4" Height="34" Margin="0,18,0,0" HorizontalAlignment="Right" Text="取消"
                                    ColorType="Normal" TextPadding="7" Padding="5,0" SnapsToDevicePixels="False" UseLayoutRounding="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</local:MyPageRight>
