<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCraft" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageSelectRight"
    PanScroll="PanBack">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：搜索 / 排序 / 刷新 / 新建 / 导入（对齐 HMCL 实例管理页的一行式工具栏）
             用 DockPanel 让搜索框自适应剩余宽度，窗口变窄时不会与右侧按钮重叠 -->
        <DockPanel Grid.Row="0" Margin="25,14,25,4" LastChildFill="True">
            <Border DockPanel.Dock="Right" Background="{DynamicResource ColorBrushCardBg}" CornerRadius="18"
                    Padding="2" VerticalAlignment="Center" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <local:MyIconButton x:Name="BtnViewMode" Width="32" Height="32" LogoScale="0.76"
                                        SvgIcon="lucide/grid-2x2" ToolTip="切换为网格视图" Click="BtnViewMode_Click" />
                    <local:MyIconButton x:Name="BtnRefresh" Width="32" Height="32" LogoScale="0.76"
                                        SvgIcon="lucide/refresh-cw" ToolTip="刷新实例列表" Click="BtnRefresh_Click" />
                    <local:MyIconButton x:Name="BtnNew" Width="32" Height="32" LogoScale="0.76"
                                        SvgIcon="lucide/download" ToolTip="下载新版本" Click="BtnNew_Click" />
                    <local:MyIconButton x:Name="BtnModpack" Width="32" Height="32" LogoScale="0.76"
                                        SvgIcon="lucide/package" ToolTip="导入整合包" Click="BtnModpack_Click" />
                    <local:MyIconButton x:Name="BtnFolder" Width="32" Height="32" LogoScale="0.76"
                                        SvgIcon="lucide/folder-open" ToolTip="打开游戏目录" Click="BtnFolder_Click" />
                </StackPanel>
            </Border>
            <Grid VerticalAlignment="Center" Margin="0,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <local:MySearchBox x:Name="TxtSearch" Grid.Column="0" Height="32" MinWidth="110" MaxWidth="280"
                                   HintText="搜索实例" TextChanged="TxtSearch_TextChanged" />
                <local:MyComboBox x:Name="ComboSort" Grid.Column="1" Width="124" Height="32" Margin="8,0,0,0"
                                  VerticalAlignment="Center" SelectionChanged="ComboSort_SelectionChanged">
                    <local:MyComboBoxItem Content="最近游玩" />
                    <local:MyComboBoxItem Content="名称 A→Z" />
                    <local:MyComboBoxItem Content="版本 新→旧" />
                    <local:MyComboBoxItem Content="安装时间" />
                </local:MyComboBox>
            </Grid>
        </DockPanel>

        <!-- 合集标签栏（只在存在合集时显示） -->
        <ScrollViewer Grid.Row="1" x:Name="ScrollCollection" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      Margin="25,0,25,4" Visibility="Collapsed">
            <StackPanel x:Name="PanCollectionBar" Orientation="Horizontal" />
        </ScrollViewer>

        <!-- 实例列表：整体加一层半透明底板，避免文字直接压在壁纸上影响可读性 -->
        <Grid Grid.Row="2" x:Name="PanAllBack">
            <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
                <Border Background="{DynamicResource ColorBrushCardBg}" CornerRadius="8" Margin="25,4,25,14" Padding="6,2,6,8">
                    <Grid>
                        <!-- 列表视图（默认） -->
                        <StackPanel Name="PanMain" Grid.IsSharedSizeScope="True" />
                        <!-- 网格视图：每组一个标题 + 一个 WrapPanel，按模式切换可见性，两套容器互不影响 -->
                        <StackPanel Name="PanGrid" Visibility="Collapsed" />
                    </Grid>
                </Border>
            </local:MyScrollViewer>
            <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanEmpty" UseAnimation="False">
                <StackPanel Margin="20,17">
                    <TextBlock Name="LabEmptyTitle" Margin="0,0,0,9" HorizontalAlignment="Center" Text="无可用版本" FontSize="19" UseLayoutRounding="True" SnapsToDevicePixels="True" Foreground="{DynamicResource ColorBrush3}" />
                    <Rectangle HorizontalAlignment="Stretch" Height="2" Fill="{DynamicResource ColorBrush3}" />
                    <TextBlock Name="LabEmptyContent" Margin="10,15,10,5" Text="未找到任何版本的游戏，请先下载任意版本的游戏。&#xa;若有已存在的游戏，请在左边的列表中选择“添加文件夹”，选择 .minecraft 文件夹将其导入。" TextWrapping="Wrap" />
                    <local:MyButton Height="35" HorizontalAlignment="Center" x:Name="BtnEmptyDownload" MinWidth="140" Text="下载游戏" Margin="0,10,0,0" Padding="13,0" ColorType="Highlight" />
                </StackPanel>
            </local:MyCard>
        </Grid>

        <!-- 加载卡必须与内容容器 PanAllBack 平级：
             内容退出动画收尾时会把 PanAllBack 整块 Visibility=Collapsed，
             卡片若还是它的子元素，刷新时镐子动画虽然跑了但完全看不见——
             这就是「点刷新没有加载动画」的真正原因（首次进页面反而能看到）。 -->
        <local:MyCard Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" x:Name="PanLoad" Margin="40" UseAnimation="False">
            <local:MyLoading Text="正在获取版本列表" Margin="20,20,20,17" x:Name="Load" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" AutoRun="False" />
        </local:MyCard>

        <!-- 实例行「更多」动画卡片：复刻首页启动按钮菜单的 Popup 卡片与三段入场动画；
             内容按实例动态构建，加入合集 / 颜色标签以二级卡片呈现（替代子菜单） -->
        <Popup x:Name="PopupInstanceMenu" AllowsTransparency="True" StaysOpen="False" PopupAnimation="None" Placement="Custom">
            <Border x:Name="CardInstanceMenu" Background="{DynamicResource ColorBrushCardBg}" CornerRadius="10" Padding="8" Margin="14"
                    Opacity="0" RenderTransformOrigin="0.5,0">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="TransformInstanceMenuScale" ScaleX="0.94" ScaleY="0.94" />
                        <TranslateTransform x:Name="TransformInstanceMenuPos" X="0" Y="10" />
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="18" ShadowDepth="3" Opacity="0.35" RenderingBias="Performance" />
                </Border.Effect>
                <local:MyScrollViewer x:Name="ScrollInstanceMenu" MaxHeight="380" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PanInstanceMenu" MinWidth="204" />
                </local:MyScrollViewer>
            </Border>
        </Popup>
    </Grid>
</local:MyPageRight>
