<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCraft" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageInstanceOptions" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,10">
            <local:MyCard Margin="0,15" UseAnimation="False">
                <StackPanel Margin="25,18,20,16">
                    <TextBlock Text="游戏选项" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock x:Name="LabDesc" Margin="0,8,0,0" FontSize="13" Opacity="0.6" TextWrapping="Wrap"
                               Foreground="{DynamicResource ColorBrush1}"
                               Text="直接编辑这个实例的 options.txt：和游戏内「选项」等价，请在游戏关闭时修改。" />
                    <TextBlock x:Name="LabPath" Margin="0,4,0,0" FontSize="12" Opacity="0.4" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
            </local:MyCard>

            <StackPanel x:Name="PanGroups" Margin="0,12,0,0" />

            <local:MyCard Title="操作" Margin="0,0,0,25" UseAnimation="False">
                <WrapPanel Margin="25,44,20,18" ItemHeight="50">
                    <local:MyButton x:Name="BtnSave" MinWidth="130" Text="保存修改" ColorType="Highlight" Margin="0,0,15,10" Click="BtnSave_Click" />
                    <local:MyButton x:Name="BtnReload" MinWidth="110" Text="重新载入" ColorType="Normal" Margin="0,0,15,10" Click="BtnReload_Click" />
                    <local:MyButton x:Name="BtnSavePreset" MinWidth="130" Text="存为预设" ColorType="Normal" Margin="0,0,15,10" Click="BtnSavePreset_Click"
                                    ToolTip="把当前这套选项存成预设，之后可以套用到其他实例。" />
                    <local:MyButton x:Name="BtnLoadPreset" MinWidth="130" Text="载入预设" ColorType="Normal" Margin="0,0,15,10" Click="BtnLoadPreset_Click"
                                    ToolTip="把某个预设的选项套用到这个实例（只覆盖预设里有的项）。" />
                    <local:MyButton x:Name="BtnFolder" MinWidth="150" Text="打开所在文件夹" ColorType="Normal" Margin="0,0,15,10" Click="BtnFolder_Click" />
                </WrapPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
