<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCraft" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageInstanceDiagnostics">
    <Grid Margin="34,16,30,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 页头 -->
        <StackPanel Grid.Row="0" Margin="4,0,4,10">
            <TextBlock Text="诊断" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
            <TextBlock x:Name="LabSubtitle" Text="查看游戏日志、崩溃报告与启动器日志，定位启动失败的原因。"
                       FontSize="13" Opacity="0.55" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource ColorBrush1}" />
        </StackPanel>

        <!-- 工具栏 -->
        <local:MyCard Grid.Row="1" UseAnimation="False" Margin="0,0,0,10">
            <StackPanel Margin="20,14,16,14">
                <WrapPanel ItemHeight="32">
                    <local:MyComboBox x:Name="ComboSource" Width="300" Height="32" Margin="0,0,10,0"
                                      SelectionChanged="ComboSource_Changed" />
                    <local:MySearchBox x:Name="TxtSearch" Width="180" Height="32" Margin="0,0,10,0"
                                       HintText="搜索日志" TextChanged="Search_Changed" />
                    <local:MyCheckBox x:Name="ChkError" Text="错误" Checked="True" Margin="0,0,8,0" Change="Check_Changed" />
                    <local:MyCheckBox x:Name="ChkWarn" Text="警告" Checked="True" Margin="0,0,8,0" Change="Check_Changed" />
                    <local:MyCheckBox x:Name="ChkInfo" Text="信息" Checked="True" Margin="0,0,8,0" Change="Check_Changed" />
                    <local:MyCheckBox x:Name="ChkDebug" Text="调试" Checked="True" Margin="0,0,8,0" Change="Check_Changed" />
                </WrapPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <local:MyButton x:Name="BtnRefresh" Grid.Row="0" Grid.Column="0" Width="120" Height="32" Text="刷新" ColorType="Highlight" Margin="0,0,10,10" Click="BtnRefresh_Click" />
                    <local:MyButton x:Name="BtnCopy" Grid.Row="0" Grid.Column="1" Width="120" Height="32" Text="复制" ColorType="Normal" Margin="0,0,10,10" Click="BtnCopy_Click" />
                    <local:MyButton x:Name="BtnExport" Grid.Row="0" Grid.Column="2" Width="120" Height="32" Text="导出…" ColorType="Normal" Margin="0,0,10,10" Click="BtnExport_Click" />
                    <local:MyButton x:Name="BtnAnalyze" Grid.Row="1" Grid.Column="0" Width="140" Height="32" Text="崩溃分析…" ColorType="Normal" Margin="0,0,10,10" Click="BtnAnalyze_Click" />
                    <local:MyButton x:Name="BtnBottom" Grid.Row="1" Grid.Column="1" Width="120" Height="32" Text="回到底部" ColorType="Normal" Margin="0,0,10,10" Click="BtnBottom_Click" />
                </Grid>
            </StackPanel>
        </local:MyCard>

        <!-- 日志正文 -->
        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1"
                BorderBrush="{DynamicResource ColorBrushGray6}"
                Background="{DynamicResource ColorBrushCardBg}">
            <Grid>
                <ListBox x:Name="PanLog" BorderThickness="0" Background="Transparent"
                         Padding="10,8" SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" Foreground="{Binding ForeBrush}"
                                       FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"
                                       TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="LabEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="没有可显示的日志。" Opacity="0.5" Foreground="{DynamicResource ColorBrush1}" />
            </Grid>
        </Border>

        <!-- 状态行 -->
        <Grid Grid.Row="3" Margin="4,8,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LabStatus" Grid.Column="0" FontSize="12" Opacity="0.55" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush1}" Text="尚未加载。" />
            <TextBlock x:Name="LabPath" Grid.Column="1" FontSize="12" Opacity="0.4" Margin="16,0,0,0"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"
                       Foreground="{DynamicResource ColorBrush1}" />
        </Grid>
    </Grid>
</local:MyPageRight>
