<local:MyPageRight x:Class="PageInstanceResourcePack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TCraft"
    mc:Ignorable="d" AllowDrop="True"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,14,25,25" Grid.IsSharedSizeScope="True">

            <local:MyHint x:Name="HintRuntime" HasBorder="True" Theme="Yellow" Margin="0,0,0,15" />

            <local:MyCard x:Name="CardPacks" Margin="0,0,0,15" Title="资源包">
                <StackPanel Margin="25,44,20,16">
                    <Grid Margin="0,0,5,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:MySearchBox x:Name="TxtSearch" Grid.Column="0" Height="32" Width="230"
                                           HorizontalAlignment="Left" HintText="搜索资源包" />
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <local:MyButton x:Name="BtnRefresh" Height="32" MinWidth="86" Padding="13,0" Margin="10,5,0,5" />
                            <local:MyButton x:Name="BtnOpen" Height="32" MinWidth="106" Padding="13,0" Margin="10,5,0,5" />
                            <local:MyButton x:Name="BtnEnableAll" Height="32" MinWidth="96" Padding="13,0" Margin="10,5,0,5" />
                            <local:MyButton x:Name="BtnDisableAll" Height="32" MinWidth="96" Padding="13,0" Margin="10,5,0,5" />
                        </WrapPanel>
                    </Grid>

                    <StackPanel x:Name="PanList" VerticalAlignment="Top" />

                    <TextBlock x:Name="LabPath" FontSize="12" Opacity="0.5" Margin="4,10,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
