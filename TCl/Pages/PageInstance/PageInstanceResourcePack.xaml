<local:MyPageRight x:Class="PageInstanceResourcePack"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TCraft"
    mc:Ignorable="d" AllowDrop="True"
    PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,14,25,25" Grid.IsSharedSizeScope="True">

            <local:MyHint x:Name="HintRuntime" HasBorder="True" Theme="Yellow" Margin="0,0,0,15" />

            <local:MyCard x:Name="CardPacks" Margin="0,0,0,15" Title="资源包">
                <StackPanel Margin="25,44,20,16">
                    <Grid Margin="0,0,5,12">
                        <Grid.ColumnDefinitions>
                            <!-- 搜索框可随窗口收窄，保证按钮单行不换行 -->
                            <ColumnDefinition Width="*" MinWidth="150" MaxWidth="230" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <local:MySearchBox x:Name="TxtSearch" Height="32"
                                           HorizontalAlignment="Left" HintText="搜索资源包" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <local:MyButton x:Name="BtnRefresh" Height="32" MinWidth="86" Padding="13,0" />
                            <local:MyButton x:Name="BtnOpen" Height="32" MinWidth="106" Padding="13,0" Margin="8,0,0,0" />
                            <local:MyButton x:Name="BtnEnableAll" Height="32" MinWidth="96" Padding="13,0" Margin="8,0,0,0" />
                            <local:MyButton x:Name="BtnDisableAll" Height="32" MinWidth="96" Padding="13,0" Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="PanList" VerticalAlignment="Top" />

                    <TextBlock x:Name="LabPath" FontSize="12" Opacity="0.5" Margin="4,10,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
        <!-- 刷新时的镐子加载卡（覆盖层，与内容平级，避免内容退出时看不到） -->
        <local:MyCard x:Name="PanLoad" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" UseAnimation="False" Visibility="Collapsed">
            <local:MyLoading Text="正在加载资源包列表" x:Name="Load" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
        </local:MyCard>
    </Grid>
</local:MyPageRight>
