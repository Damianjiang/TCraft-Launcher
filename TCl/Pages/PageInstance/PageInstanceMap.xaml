<local:MyPageRight x:Class="PageInstanceMap"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:TCraft"
                   mc:Ignorable="d" x:Name="PageRoot"
                   PanScroll="{Binding ElementName=PanBack}" Grid.IsSharedSizeScope="True">
    <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Name="PanMain" Margin="25,14,25,25">
            <!-- 页头：标题 + 世界选择 -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="世界地图" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock x:Name="LabInfo" Text="选择一个存档即可查看它已探索的地形。" FontSize="13" Opacity="0.55" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <local:MyComboBox x:Name="ComboWorld" Width="128" Height="32" Margin="0,0,8,0" />
                    <local:MyButton x:Name="BtnFit" MinWidth="70" Height="32" Text="适应" Margin="0,0,8,0" ColorType="Normal" />
                    <local:MyButton x:Name="BtnRefresh" MinWidth="56" Height="32" Text="刷新" ColorType="Normal" />
                </StackPanel>
            </Grid>
            <!-- 地图视口：瓦片挂在 PanTiles 上，经 Scale + Translate 变换后由外层裁剪 -->
            <Border x:Name="PanViewport" Height="430" Background="#14221f1c" ClipToBounds="True"
                    CornerRadius="6" BorderBrush="{DynamicResource ColorBrush6}" BorderThickness="1">
                <Canvas x:Name="PanHost">
                    <Canvas x:Name="PanTiles">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="TransScale" />
                                <TranslateTransform x:Name="TransMove" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                </Canvas>
            </Border>
            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="LabCoord" Text="" FontSize="12" Opacity="0.55" Foreground="{DynamicResource ColorBrush1}" />
                <TextBlock Text="拖动平移 · 滚轮缩放" FontSize="12" Opacity="0.4" HorizontalAlignment="Right" Foreground="{DynamicResource ColorBrush1}" />
            </Grid>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
