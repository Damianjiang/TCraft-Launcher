<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:TCraft" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" x:Class="PageInstanceScreenshot"
    PanScroll="{Binding ElementName=PanBack}" Grid.IsSharedSizeScope="True">
    <Grid x:Name="PanRoot">
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <Grid>
                <local:MyCard HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40" x:Name="PanNoPic">
                    <Grid Margin="20,17">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Margin="0,0,0,9" HorizontalAlignment="Center"
                                   Text="还没有截图" FontSize="19"
                                   UseLayoutRounding="True" SnapsToDevicePixels="True"
                                   Foreground="{DynamicResource ColorBrush3}" />
                        <Rectangle Grid.Row="1" Grid.ColumnSpan="4" HorizontalAlignment="Stretch" Height="2"
                                   Fill="{DynamicResource ColorBrush3}" />
                        <TextBlock Grid.Row="2" Grid.ColumnSpan="4" Margin="10,15,10,5"
                                   Text="在游戏内按下 F2 即可截图，截图会保存在当前版本的 screenshots 文件夹中。" TextWrapping="Wrap" />
                        <local:MyButton Grid.Row="3" Grid.Column="1" Height="35" HorizontalAlignment="Center"
                                        x:Name="BtnOpenFolderTop" MinWidth="140"
                                        Text="打开截图文件夹" Margin="10,10,10,0"
                                        Padding="13,0" ColorType="Highlight" />
                    </Grid>
                </local:MyCard>
                <StackPanel Orientation="Vertical" Margin="10,25,10,10" x:Name="PanContent">
                    <local:MyCard Margin="15,0,15,15" Title="快速操作" UseAnimation="False">
                        <Grid Height="35" Margin="25,40,15,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            </Grid.ColumnDefinitions>
                            <local:MyButton Grid.Column="0" MinWidth="140"
                                            Text="打开截图文件夹" Padding="13,0"
                                            Margin="0,0,20,0"
                                            HorizontalAlignment="Left" x:Name="BtnOpenFolder" ColorType="Highlight" />
                        </Grid>
                    </local:MyCard>
                    <TextBlock Text="点缩略图可看大图，大图里能前后翻、复制、在文件夹中显示或删除。" FontSize="12" Opacity="0.55"
                               Margin="18,0,18,10" Foreground="{DynamicResource ColorBrush1}" />
                    <WrapPanel Margin="8,0,8,25" Name="PanList" HorizontalAlignment="Center" Orientation="Horizontal" />
                </StackPanel>
            </Grid>
        </local:MyScrollViewer>

        <!-- 大图查看器：点缩略图打开，可前后翻、复制、打开位置、删除 -->
        <Grid x:Name="PanViewer" Visibility="Collapsed" Background="#D9101418" Focusable="True"
              PreviewKeyDown="PanViewer_KeyDown">
            <Grid Margin="30,22,30,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Image x:Name="ImgViewer" Grid.Row="0" Stretch="Uniform" Margin="64,26,64,0" />
                <TextBlock x:Name="LabViewer" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                           Foreground="#DDFFFFFF" FontSize="12" Margin="4,0,0,0" IsHitTestVisible="False" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <local:MyButton x:Name="BtnViewerPrev" MinWidth="90" Height="34" Text="上一张" ColorType="Dark"
                                    Padding="13,0" Margin="0,0,10,0" Click="BtnViewerPrev_Click" />
                    <local:MyButton x:Name="BtnViewerNext" MinWidth="90" Height="34" Text="下一张" ColorType="Dark"
                                    Padding="13,0" Margin="0,0,10,0" Click="BtnViewerNext_Click" />
                    <local:MyButton x:Name="BtnViewerCopy" MinWidth="90" Height="34" Text="复制图片" ColorType="Dark"
                                    Padding="13,0" Margin="0,0,10,0" Click="BtnViewerCopy_Click" />
                    <local:MyButton x:Name="BtnViewerOpen" MinWidth="120" Height="34" Text="在文件夹中显示" ColorType="Dark"
                                    Padding="13,0" Margin="0,0,10,0" Click="BtnViewerOpen_Click" />
                    <local:MyButton x:Name="BtnViewerDelete" MinWidth="90" Height="34" Text="删除" ColorType="Red"
                                    Padding="13,0" Margin="0,0,10,0" Click="BtnViewerDelete_Click" />
                    <local:MyButton x:Name="BtnViewerClose" MinWidth="90" Height="34" Text="关闭" ColorType="Dark"
                                    Padding="13,0" Click="BtnViewerClose_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</local:MyPageRight>
