<local:MyPageLeft x:Class="PageInstanceLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TCraft" AnimatedControl="PanItem">
    <StackPanel Margin="0,12,0,0" Name="PanItem">
        <local:MyListItem x:Name="ItemOverall" IsScaleAnimationEnabled="False" Checked="True" Type="RadioBox" Tag="0" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="概览"
                          SvgIcon="lucide/box" />
        <local:MyListItem x:Name="ItemDiagnostics" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="13" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="诊断" SvgIcon="lucide/activity" />
        <local:MyListItem x:Name="ItemOptions" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="14" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="游戏选项" SvgIcon="lucide/sliders-horizontal" />
        <local:MyListItem x:Name="ItemHistory" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="15" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="历史" SvgIcon="lucide/history" />
        <local:MyListItem x:Name="ItemSetup" IsScaleAnimationEnabled="False" Tag="1" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="设置" Type="RadioBox"
                          SvgIcon="lucide/settings">
            <local:MyListItem.Buttons>
                <x:Array Type="{x:Type local:MyIconButton}">
                    <local:MyIconButton Tag="1" ToolTip="初始化" Click="Reset" SvgIcon="lucide/rotate-ccw" LogoScale="0.9" />
                </x:Array>
            </local:MyListItem.Buttons>
        </local:MyListItem>
        <local:MyListItem x:Name="ItemModify" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="2" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="修改" LogoScale="0.95"
                          SvgIcon="lucide/pencil" >
            <local:MyListItem.Buttons>
                <x:Array Type="{x:Type local:MyIconButton}">
                    <local:MyIconButton Tag="2" ToolTip="刷新" Click="Refresh_Click" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
                </x:Array>
            </local:MyListItem.Buttons>
        </local:MyListItem>
        <local:MyListItem x:Name="ItemMod" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="3" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="Mod 管理"
                          SvgIcon="lucide/puzzle" >
            <local:MyListItem.Buttons>
                <x:Array Type="{x:Type local:MyIconButton}">
                    <local:MyIconButton Tag="3" ToolTip="刷新" Click="Refresh_Click" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
                </x:Array>
            </local:MyListItem.Buttons>
        </local:MyListItem>
        <local:MyListItem x:Name="ItemResourcePack" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="16" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="资源包"
                          SvgIcon="lucide/palette" />
        <local:MyListItem x:Name="ItemShader" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="17" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="光影"
                          SvgIcon="lucide/sun" />
        <local:MyListItem x:Name="ItemMap" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="18" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="世界地图"
                          SvgIcon="lucide/earth" />
        <local:MyListItem x:Name="ItemModDisabled" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="4" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="Mod 管理"
                          SvgIcon="lucide/puzzle" />
        <local:MyListItem x:Name="ItemExport" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="5" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="导出"
                          SvgIcon="lucide/upload">
            <local:MyListItem.Buttons>
                <x:Array Type="{x:Type local:MyIconButton}">
                    <local:MyIconButton Tag="5" ToolTip="刷新" Click="Refresh_Click" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
                </x:Array>
            </local:MyListItem.Buttons>
        </local:MyListItem>
        <local:MyListItem x:Name="ItemSaves" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="6" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="存档"
                          LogoScale="0.95"
                          SvgIcon="lucide/map">
            <local:MyListItem.Buttons>
                <x:Array Type="{x:Type local:MyIconButton}">
                    <local:MyIconButton Tag="6" ToolTip="刷新" Click="Refresh_Click" LogoScale="0.85" SvgIcon="lucide/refresh-cw" />
                </x:Array>
            </local:MyListItem.Buttons>
        </local:MyListItem>
        <local:MyListItem x:Name="ItemScreenshot" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="7" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="截图" SvgIcon="lucide/image">
            <local:MyListItem.Buttons>
                <x:Array Type="{x:Type local:MyIconButton}">
                    <local:MyIconButton Tag="7" ToolTip="刷新" LogoScale="0.85" Click="Refresh_Click" SvgIcon="lucide/refresh-cw" />
                </x:Array>
            </local:MyListItem.Buttons>
        </local:MyListItem>
        <local:MyListItem x:Name="ItemServer" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="8" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="服务器" SvgIcon="lucide/server">
            <local:MyListItem.Buttons>
                <x:Array Type="{x:Type local:MyIconButton}">
                    <local:MyIconButton Tag="8" ToolTip="刷新" LogoScale="0.85" Click="Refresh_Click" SvgIcon="lucide/refresh-cw" />
                </x:Array>
            </local:MyListItem.Buttons>
        </local:MyListItem>
        <local:MyListItem x:Name="ItemJarInJar" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="9" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="嵌套依赖" SvgIcon="lucide/boxes" />
        <local:MyListItem x:Name="ItemCompResource" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="10" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="整合包清单" SvgIcon="lucide/package" />
        <local:MyListItem x:Name="ItemInstallNew" IsScaleAnimationEnabled="False" Type="Clickable" Tag="11" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="安装新版本" SvgIcon="lucide/download" />
        <local:MyListItem x:Name="ItemCopyInstance" IsScaleAnimationEnabled="False" Type="Clickable" Tag="16" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="复制实例" SvgIcon="lucide/copy" />
        <local:MyListItem x:Name="ItemBackupInstance" IsScaleAnimationEnabled="False" Type="Clickable" Tag="17" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="备份与恢复" SvgIcon="lucide/archive" />
        <local:MyListItem x:Name="ItemImportInstance" IsScaleAnimationEnabled="False" Type="Clickable" Tag="18" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="导入其他启动器实例" SvgIcon="lucide/folder-input" />
        <local:MyListItem x:Name="ItemSavesDatapack" IsScaleAnimationEnabled="False" Type="RadioBox" Tag="12" MinPaddingRight="35" Height="36" VerticalAlignment="Top" Title="存档数据包" SvgIcon="lucide/file-box" />
    </StackPanel>
</local:MyPageLeft>
