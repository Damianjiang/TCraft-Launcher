<local:MyPageRight x:Class="PageInstanceShader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TCraft"
    mc:Ignorable="d" AllowDrop="True"
    PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,14,25,25" Grid.IsSharedSizeScope="True">

            <StackPanel x:Name="PanLoaderHint" Margin="0,0,0,15">
                <local:MyHint x:Name="HintLoader" HasBorder="True" Theme="Red" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <local:MyButton x:Name="BtnDownloadLoader" Height="32" MinWidth="160" Padding="13,0"
                                    ColorType="Highlight" HorizontalAlignment="Left" />
                    <local:MyButton x:Name="BtnRefreshLoader" Height="32" MinWidth="110" Padding="13,0"
                                    Margin="10,0,0,0" HorizontalAlignment="Left" />
                </StackPanel>
            </StackPanel>

            <local:MyCard x:Name="CardShaders" Margin="0,0,0,15" Title="光影包">
                <StackPanel Margin="25,44,20,16">
                    <Grid Margin="0,0,5,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:MySearchBox x:Name="TxtSearch" Grid.Column="0" Height="32" Width="230"
                                           HorizontalAlignment="Left" HintText="搜索光影包" />
                        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <local:MyButton x:Name="BtnRefresh" Height="32" MinWidth="86" Padding="13,0" Margin="10,0,0,0" />
                            <local:MyButton x:Name="BtnOpen" Height="32" MinWidth="106" Padding="13,0" Margin="10,0,0,0" />
                            <local:MyButton x:Name="BtnClear" Height="32" MinWidth="126" Padding="13,0" Margin="10,0,0,0" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock x:Name="LabCurrent" FontSize="13" Opacity="0.6" Margin="4,0,0,10"
                               TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}" />

                    <StackPanel x:Name="PanList" VerticalAlignment="Top" />

                    <TextBlock x:Name="LabPath" FontSize="12" Opacity="0.5" Margin="4,10,0,0"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource ColorBrush1}" />
                </StackPanel>
            </local:MyCard>

        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
