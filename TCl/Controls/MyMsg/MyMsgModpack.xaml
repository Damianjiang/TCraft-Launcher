<Grid x:Class="MyMsgModpack"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:my="clr-namespace:TCraft"
             RenderTransformOrigin="0.5,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="400" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="TransformScale" ScaleX="0.92" ScaleY="0.92" />
            <TranslateTransform x:Name="TransformPos" X="0" Y="18" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border Name="PanBorder" CornerRadius="7" Background="#FBFBFB">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="20" ShadowDepth="4" RenderingBias="Performance" Opacity="0.8" x:Name="EffectShadow" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="22,22,22,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="13" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="23" TextTrimming="None" Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Left" Name="LabTitle" Margin="7,-1,70,9" Text="安装整合包" VerticalAlignment="Top" SnapsToDevicePixels="False" UseLayoutRounding="False" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />

            <!-- 整合包信息：图标 + 名称 + 类型/版本 -->
            <Grid Grid.Row="3" Margin="7,0,7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Width="60" Height="60" CornerRadius="6" VerticalAlignment="Top" Background="{DynamicResource ColorBrush4}" SnapsToDevicePixels="True">
                    <Grid>
                        <my:MyImage x:Name="ImgIcon" Stretch="UniformToFill" />
                        <Border x:Name="PanIconEmpty" Background="{DynamicResource ColorBrush4}">
                            <TextBlock Text="ZIP" FontSize="15" FontWeight="Bold" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" />
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LabPackName" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="#FF3A3A3A" SnapsToDevicePixels="False" />
                    <TextBlock x:Name="LabPackMeta" FontSize="12" Margin="0,5,0,0" Opacity="0.55" Foreground="#FF5C5C5C" TextTrimming="CharacterEllipsis" SnapsToDevicePixels="False" />
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="4" x:Name="LabCaption" Margin="7,18,7,4" FontSize="14" TextWrapping="Wrap" LineHeight="20"
                       Foreground="#FF5C5C5C" Text="是否安装此整合包？安装后会作为一个新实例出现在实例列表中。" />

            <StackPanel Grid.Row="5" Name="PanBtn" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="150,14,8,0" Orientation="Horizontal">
                <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="安装" x:Name="Btn1" Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
                <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="取消" x:Name="Btn2" Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
            </StackPanel>
        </Grid>
    </Border>
</Grid>
