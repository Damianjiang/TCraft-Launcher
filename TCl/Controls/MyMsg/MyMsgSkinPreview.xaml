<Grid x:Class="MyMsgSkinPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:my="clr-namespace:TCraft"
             RenderTransformOrigin="0.5,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="470" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="TransformScale" ScaleX="0.92" ScaleY="0.92" />
            <TranslateTransform x:Name="TransformPos" X="0" Y="18" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border Name="PanBorder" CornerRadius="7" Background="#FBFBFB">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="20" ShadowDepth="4" RenderingBias="Performance" Opacity="0.8" x:Name="EffectShadow" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="22,22,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="23" TextTrimming="None" Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Left" Name="LabTitle" Margin="7,-1,70,9" Text="皮肤预览" VerticalAlignment="Top" SnapsToDevicePixels="False" UseLayoutRounding="False" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />
            <!--左侧 3D 预览，右侧皮肤信息-->
            <Grid Grid.Row="3" Margin="7,0,7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="PanPreviewBack" Grid.Column="0" CornerRadius="5" Background="{DynamicResource ColorBrush7}" Margin="0,0,14,0"
                        Height="284" VerticalAlignment="Top">
                    <my:MySkin3D x:Name="Skin3D" Width="196" Height="284" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" MinWidth="200" VerticalAlignment="Top" Margin="0,2,0,0">
                    <TextBlock x:Name="LabNameTitle" FontSize="13" Opacity="0.55" Text="玩家名" />
                    <TextBlock x:Name="LabName" FontSize="17" Margin="0,2,0,14" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush2}" />
                    <TextBlock x:Name="LabModelTitle" FontSize="13" Opacity="0.55" Text="模型" />
                    <TextBlock x:Name="LabModel" FontSize="15" Margin="0,2,0,14" Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock x:Name="LabSourceTitle" FontSize="13" Opacity="0.55" Text="来源" />
                    <TextBlock x:Name="LabSource" FontSize="15" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrush1}" />
                    <TextBlock x:Name="LabHint" FontSize="12.5" Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="17"
                               Foreground="{DynamicResource ColorBrush1}" Opacity="0.5" />
                </StackPanel>
            </Grid>
            <!--底部：只有按钮（提示放在右侧信息栏，避免换行把按钮挤出窗口）-->
            <Grid Grid.Row="4" Margin="7,10,7,0">
                <StackPanel Name="PanBtn" VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal">
                    <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="关闭" x:Name="BtnClose" Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
                    <my:MyButton ColorType="Highlight" x:FieldModifier="public" Text="保存" x:Name="BtnSave" Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Grid>
