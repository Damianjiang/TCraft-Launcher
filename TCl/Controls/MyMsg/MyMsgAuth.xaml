<Grid x:Class="MyMsgAuth"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:my="clr-namespace:TCraft"
             AllowDrop="True"
             RenderTransformOrigin="0.5,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True" MinWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
    <Grid.RenderTransform>
        <TransformGroup>
            <ScaleTransform x:Name="TransformScale" ScaleX="0.92" ScaleY="0.92" />
            <TranslateTransform x:Name="TransformPos" X="0" Y="18" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border Name="PanBorder" CornerRadius="7" Background="#FBFBFB">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObject1}" BlurRadius="20" ShadowDepth="4" RenderingBias="Performance" Opacity="0.8" x:Name="EffectShadow" />
        </Border.Effect>
        <Grid Name="PanMain" VerticalAlignment="Top" Margin="22,22,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" FontSize="23" TextTrimming="None" Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Left" Name="LabTitle" Margin="7,-1,70,9" Text="添加 LittleSkin 账号" VerticalAlignment="Top" SnapsToDevicePixels="False" UseLayoutRounding="False" />
            <Rectangle x:Name="ShapeLine" Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />
            <!--表单：玩家名 + 密码 + 认证服务器（可把 LittleSkin 的「外置登录」按钮拖进来自动识别）-->
            <Grid Grid.Row="3" x:Name="PanForm" Margin="7,0,7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" x:Name="LabName" Text="玩家名" FontSize="14" Margin="2,0,15,12" VerticalAlignment="Center" />
                <my:MyTextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,12" x:Name="TextName" MaxLength="60" />
                <TextBlock Grid.Row="1" Grid.Column="0" x:Name="LabPass" Text="密码" FontSize="14" Margin="2,0,15,12" VerticalAlignment="Center" />
                <PasswordBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,12" x:Name="TextPass" />
                <TextBlock Grid.Row="2" Grid.Column="0" x:Name="LabServer" Text="认证服务器" FontSize="14" Margin="2,0,15,12" VerticalAlignment="Center" />
                <my:MyTextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,12" x:Name="TextServer" />
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="LabHint" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" Opacity="0.7" TextWrapping="Wrap" Margin="2,0,0,4">
                    默认为 LittleSkin（littleskin.cn）。你也可以把 LittleSkin「用户中心 → 外置登录」里那个按钮拖进上面这格，会自动识别对应的认证服务器。
                </TextBlock>
            </Grid>
            <!--底部：错误信息 + 登录 / 取消-->
            <Grid Grid.Row="4" Margin="7,4,7,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LabError" FontSize="13" Foreground="Red" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="2,0,0,0" />
                <StackPanel Grid.Column="1" Name="PanBtn" VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal">
                    <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="登录" x:Name="Btn1" Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
                    <my:MyButton ColorType="Normal" x:FieldModifier="public" Text="取消" x:Name="Btn2" Margin="12,0,0,0" TextPadding="7" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Grid>
